	store := ensure_session_store_impl(store_input)
	update_fn := dict_get_or(store, "update_session_fn", null)
	if type(update_fn) != "function" {
		return not_implemented_result("update_session")
	}

	return update_fn(store, resolve_session_id_value(session_id_input, {
		"fallback": "session-default"
	}), normalize_dict(patch_input))
}

