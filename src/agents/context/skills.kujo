from src.agents.context.ledger import context_get, context_hash
from src.agents.context.manifest import context_error, context_fetch

func load_skill(catalog, id, triggers, capabilities, store, visited) {
    if contains(visited, id) || len(visited) >= 16 { return context_error("skill_dependency_cycle") }
    if has_key(catalog, id) == 0 { return context_error("missing_skill") }
    let skill := catalog[id]
    if context_get(skill, "serialization_version", "") != "kujo.skill-context/v1" { return context_error("unsupported_skill_version") }
    let fields := ["serialization_version", "skill_id", "core", "references", "triggers", "capabilities", "security_rules", "estimated_tokens", "content_hash", "tests", "dependencies"]
    if sort(keys(skill)) != sort(fields) || skill["skill_id"] != id { return context_error("invalid_skill_metadata") }
    for field in ["references", "triggers", "capabilities", "security_rules", "tests", "dependencies"] {
        if type(skill[field]) != "array" { return context_error("invalid_skill_metadata") }
    }
    mut hashable := {}
    for key in keys(skill) { if key != "content_hash" { hashable[key] = skill[key] } }
    if context_hash(hashable) != skill["content_hash"] { return context_error("skill_manifest_drift") }
    for capability in skill["capabilities"] { if contains(capabilities, capability) == false { return context_error("skill_capability_denied") } }
    let next_visited := push(visited, id)
    mut loaded := []
    for dependency in skill["dependencies"] {
        let result := load_skill(catalog, dependency, triggers, capabilities, store, next_visited)
        if result["ok"] == false { return result }
        loaded = concat(loaded, result["loaded"])
    }
    mut references := [{"kind": "skill_core", "reference": skill["core"]}]
    for rule in skill["security_rules"] { references = push(references, {"kind": "security_rule", "reference": rule}) }
    for item in skill["references"] {
        if type(item) != "dict" || type(context_get(item, "trigger", null)) != "string" { return context_error("invalid_reference_trigger") }
        if contains(skill["triggers"], item["trigger"]) == false { return context_error("undeclared_reference_trigger") }
        if contains(triggers, item["trigger"]) { references = push(references, {"kind": "skill_reference", "reference": context_get(item, "reference", {})}) }
    }
    for item in references {
        let fetched := context_fetch(store, item["reference"])
        if fetched["ok"] == false { return fetched }
        loaded = push(loaded, {"skill_id": id, "kind": item["kind"], "reference": item["reference"], "content": fetched["artifact"]["content"]})
    }
    return {"ok": true, "loaded": loaded}
}

export func context_load_skills(catalog, selected_ids, triggers, capabilities, store) {
    if type(catalog) != "dict" || type(selected_ids) != "array" || type(triggers) != "array" || type(capabilities) != "array" { return context_error("invalid_skill_selection") }
    mut loaded := []
    mut seen := []
    for id in sort(selected_ids) {
        let result := load_skill(catalog, id, triggers, capabilities, store, [])
        if result["ok"] == false { return result }
        for item in result["loaded"] {
            let identity := item["skill_id"] + ":" + item["kind"] + ":" + item["reference"]["content_hash"]
            if contains(seen, identity) == false { loaded = push(loaded, item); seen = push(seen, identity) }
        }
    }
    return {"ok": true, "serialization_version": "kujo.skill-load/v1", "loaded": loaded}
}
