from src.agents.integrations.adapters import describe_integration_adapters_module

func describe_module_tree_impl() {
	modules := {
		"core_types": describe_core_types_module(),
		"errors": describe_errors_module(),
		"events": describe_events_module(),
		"runner": describe_runner_module(),
		"tools.registry": describe_tools_registry_module(),
		"security.approval": describe_approval_module(),
		"sessions.store": describe_session_store_module(),
		"memory.store": describe_memory_store_module(),
		"retrieval.provider": describe_retrieval_provider_module(),
		"handoffs.handoff": describe_handoff_module(),
		"tracing.sink": describe_trace_sink_module(),
		"artifacts.store": describe_artifact_store_module(),
		"budgets.limits": describe_budget_limits_module(),
		"streaming.events": describe_streaming_events_module(),
		"integrations.adapters": describe_integration_adapters_module()
	}

	return {
		"module": "agents.index",
		"module_count": len(keys(modules)),
		"modules": modules,
		"status": "active",
		"maturity": "experimental",
		"readiness": "production_oriented",
		"contract_version": "0.1.0"
	}
}

export describe_module_tree := describe_module_tree_impl
export describe_core_types_module := describe_core_types_module
export describe_errors_module := describe_errors_module
