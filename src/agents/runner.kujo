func dict_get_or(obj, key, default_value) {
	source := unwrap_dict(obj)
	if type(source) != "dict" {
		return default_value
	}
	target_key := to_string(key)
	for existing_key in keys(source) {
		if to_string(existing_key) == target_key {
			return source[existing_key]
		}
	}
	return default_value
}

func unwrap_dict(value) {
	if type(value) != "dict" {
		return value
	}

	if has_key(value, "_self") == 1 {
		inner := value["_self"]
		if type(inner) == "dict" {
			return inner
		}
	}

	return value
}

func normalize_string(value, fallback) {
	if type(value) == "dict" {
		if has_key(value, "_self") == 1 {
			inner := value["_self"]
			if type(inner) == "string" {
				trimmed_inner := trim(inner)
				if trimmed_inner != "" {
					return trimmed_inner
				}
			}
		}
	}

	if type(value) == "string" {
		trimmed := trim(value)
		if trimmed != "" {
			return trimmed
		}
	}
	return fallback
}

func normalize_text(value, fallback) {
	text := normalize_string(value, "")
	if text != "" {
		return text
	}

	if type(value) == "null" {
		return fallback
	}

	if type(value) == "dict" {
		if has_key(value, "value") == 1 {
			return normalize_text(value["value"], fallback)
		}
	}

	if type(value) != "array" && type(value) != "dict" {
		coerced := trim(to_string(value))
		if coerced != "" {
			return coerced
		}
	}

	return fallback
}

func normalize_dict(value) {
	unwrapped := unwrap_dict(value)
	if type(unwrapped) == "dict" {
		return unwrapped
	}
	return {}
}

func normalize_array(value) {
	if type(value) == "array" {
		return value
	}

	if type(value) == "dict" {
		if has_key(value, "_self") == 1 {
			inner := value["_self"]
			if type(inner) == "array" {
				return inner
			}
		}
	}

	return []
}

func normalize_string_array(values_input) {
	values := normalize_array(values_input)
	normalized := []

	index := 0
	total := len(values)
	while index < total {
		value_text := normalize_text(values[index], "")
		if value_text != "" {
			normalized = push(normalized, value_text)
		}
		index = index + 1
	}

	return normalized
}

func string_array_contains(values_input, expected_input) {
	values := normalize_string_array(values_input)
	expected := normalize_text(expected_input, "")
	if expected == "" {
		return false
	}

	index := 0
	total := len(values)
	while index < total {
		if normalize_text(values[index], "") == expected {
			return true
		}
		index = index + 1
	}

	return false
}

func resolve_handoff_loop_state(run_request_input, options_map_input, agent_id_input) {
	run_request := normalize_dict(run_request_input)
	options_map := normalize_dict(options_map_input)
	metadata := normalize_dict(dict_get_or(run_request, "metadata", {}))
	agent_id := normalize_text(agent_id_input, "")

	depth := normalize_non_negative_int(dict_get_or(options_map, "handoff_depth", dict_get_or(run_request, "handoff_depth", dict_get_or(metadata, "handoff_depth", 0))), 0)
	max_depth := normalize_non_negative_int(dict_get_or(options_map, "handoff_max_depth", dict_get_or(run_request, "handoff_max_depth", dict_get_or(metadata, "handoff_max_depth", 3))), 3)
	if max_depth <= 0 {
		max_depth = 1
	}

	visited_targets := normalize_string_array(dict_get_or(options_map, "handoff_visited_targets", dict_get_or(run_request, "handoff_visited_targets", dict_get_or(metadata, "handoff_visited_targets", []))))
	if agent_id != "" {
		if string_array_contains(visited_targets, agent_id) == false {
			visited_targets = push(visited_targets, agent_id)
		}
	}

	return {
		"depth": depth,
		"max_depth": max_depth,
		"visited_targets": visited_targets
	}
}

func normalize_non_negative_int(value, fallback) {
	if type(value) == "int" {
		if value >= 0 {
			return value
		}
	}
	return fallback
}

func normalize_bool(value, fallback) {
	if type(value) == "bool" {
		return value
	}
	if type(value) == "int" {
		return value != 0
	}
	return fallback
}

func copy_dict(source_input) {
	source := normalize_dict(source_input)
	cloned := {}
	for key in keys(source) {
		cloned[key] := source[key]
	}
	return cloned
}

func clone_value(value) {
	if type(value) == "dict" {
		source := normalize_dict(value)
		cloned := {}
		for key in keys(source) {
			cloned[key] := clone_value(source[key])
		}
		return cloned
	}

	if type(value) == "array" {
		cloned := []
		for item in value {
			cloned = push(cloned, clone_value(item))
		}
		return cloned
	}

	return value
}

func append_lifecycle_result(results_input, stage_input, result_input) {
	results := normalize_array(results_input)
	result := normalize_dict(result_input)

	return push(results, {
		"stage": normalize_string(stage_input, "unknown"),
		"ok": dict_get_or(result, "ok", false),
		"result": result
	})
}

func normalize_cancellation_token(token_input) {
	if type(token_input) == "dict" {
		if dict_get_or(token_input, "type", "") == "CancellationToken" {
			return token_input
		}
		return create_cancellation_token(token_input)
	}
	return create_cancellation_token({})
}

func resolve_retry_policy(options_map, run_request, agent_map) {
	policy := normalize_dict(dict_get_or(options_map, "retry_policy", dict_get_or(run_request, "retry_policy", dict_get_or(agent_map, "retry_policy", {}))))

	return {
		"max_model_retries": normalize_non_negative_int(dict_get_or(policy, "max_model_retries", 0), 0),
		"max_tool_retries": normalize_non_negative_int(dict_get_or(policy, "max_tool_retries", 0), 0)
	}
}

func create_retry_counters(retry_policy, model_attempts, model_retries_used, tool_attempts, tool_retries_used) {
	policy := normalize_dict(retry_policy)

	return {
		"max_model_retries": normalize_non_negative_int(dict_get_or(policy, "max_model_retries", 0), 0),
		"max_tool_retries": normalize_non_negative_int(dict_get_or(policy, "max_tool_retries", 0), 0),
		"model_attempts": normalize_non_negative_int(model_attempts, 0),
		"model_retries_used": normalize_non_negative_int(model_retries_used, 0),
		"tool_attempts": normalize_non_negative_int(tool_attempts, 0),
		"tool_retries_used": normalize_non_negative_int(tool_retries_used, 0)
	}
}

func is_retryable_model_result(model_result) {
	if dict_get_or(model_result, "ok", false) {
		return false
	}

	error_payload := normalize_dict(dict_get_or(model_result, "error", {}))
	if dict_get_or(error_payload, "retryable", false) == true {
		return true
	}

	error_kind := normalize_string(dict_get_or(error_payload, "kind", ""), "")
	if error_kind == "timeout" || error_kind == "provider_error" {
		return true
	}

	status_code := dict_get_or(model_result, "status_code", 0)
	if type(status_code) == "int" {
		if status_code == 408 || status_code == 429 || status_code >= 500 {
			return true
		}
	}

	return false
}

func with_retry_attempt_options(request_options, attempt, max_attempts) {
	options := copy_dict(request_options)
	metadata := normalize_dict(dict_get_or(options, "metadata", {}))

	metadata["retry_attempt"] := attempt
	metadata["retry_max_attempts"] := max_attempts

	options["metadata"] := metadata
	options["retry_attempt"] := attempt
	options["retry_max_attempts"] := max_attempts

	return options
}

func execute_model_with_retry_attempt(ai_adapter, messages, request_options, attempt, max_attempts) {
	attempt_options := with_retry_attempt_options(request_options, attempt, max_attempts)
	model_result := call_chat(ai_adapter, messages, attempt_options)

	if dict_get_or(model_result, "ok", false) {
		return {
			"model_result": model_result,
			"model_attempts": attempt,
			"model_retries_used": attempt - 1
		}
	}

	if attempt >= max_attempts || is_retryable_model_result(model_result) == false {
		return {
			"model_result": model_result,
			"model_attempts": attempt,
			"model_retries_used": attempt - 1
		}
	}

	return execute_model_with_retry_attempt(ai_adapter, messages, request_options, attempt + 1, max_attempts)
}

func execute_model_with_retry_policy(ai_adapter, messages, request_options, retry_policy) {
	max_model_retries := normalize_non_negative_int(dict_get_or(retry_policy, "max_model_retries", 0), 0)
	max_attempts := max_model_retries + 1

	return execute_model_with_retry_attempt(ai_adapter, messages, request_options, 1, max_attempts)
}

func resolve_stream_enabled(options_map_input, run_request_input, agent_map_input) {
	options_map := normalize_dict(options_map_input)
	run_request := normalize_dict(run_request_input)
	agent_map := normalize_dict(agent_map_input)

	from_options := dict_get_or(options_map, "stream", null)
	if type(from_options) == "bool" || type(from_options) == "int" {
		return normalize_bool(from_options, false)
	}

	from_request := dict_get_or(run_request, "stream", null)
	if type(from_request) == "bool" || type(from_request) == "int" {
		return normalize_bool(from_request, false)
	}

	from_policy := dict_get_or(normalize_dict(dict_get_or(agent_map, "policy", {})), "stream", null)
	if type(from_policy) == "bool" || type(from_policy) == "int" {
		return normalize_bool(from_policy, false)
	}

	return false
}

func infer_ai_stream_event_type(ai_event_input) {
	ai_event := normalize_dict(ai_event_input)
	fallback_type := "delta"

	try {
		candidate_type := normalize_string(ai_event["type"], "")
		if candidate_type != "" {
			return candidate_type
		}
	} except err {
		// Some wrapped map values can fail direct key access even when key iteration reports presence.
	}

	ai_event_text := ""
	try {
		ai_event_text = to_string(ai_event_input)
	} except err {
		ai_event_text = ""
	}
	if index_of(ai_event_text, "guardrail_blocked") >= 0 {
		fallback_type = "guardrail_blocked"
	}

	return fallback_type
}

func map_ai_stream_event_with_fallback(ai_event_input, run_id, agent_id, session_id, step_id, sequence_value, runtime_services_input) {
	context := {
		"run_id": run_id,
		"agent_id": agent_id,
		"session_id": session_id,
		"step_id": step_id,
		"sequence": sequence_value,
		"runtime_services": runtime_services_input
	}

	try {
		return {
			"event": map_ai_sdk_stream_event(ai_event_input, context),
			"mapping_error": ""
		}
	} except err {
		fallback_type := infer_ai_stream_event_type(ai_event_input)
		fallback_payload := {}
		if fallback_type == "guardrail_blocked" {
			fallback_payload = {
				"reason": "guardrail_blocked"
			}
		}

		fallback_event := map_ai_sdk_stream_event({
			"type": fallback_type,
			"payload": fallback_payload
		}, context)

		fallback_event_map := normalize_dict(fallback_event)
		metadata := normalize_dict(dict_get_or(fallback_event_map, "metadata", {}))
		metadata["mapping_error"] := to_string(err)
		fallback_event_map["metadata"] := metadata

		return {
			"event": fallback_event_map,
			"mapping_error": to_string(err)
		}
	}
}

func execute_model_with_stream(ai_adapter, messages, request_options, run_id, agent_id, session_id, step_id, runtime_services_input, options_map_input) {
	options_map := normalize_dict(options_map_input)
	runtime_services := runtime_services_input
	stream_state := {
		"sequence": 0,
		"events": [],
		"callback_error": "",
		"guardrail_blocked": false,
		"stage": "initialized",
		"runtime_services": runtime_services
	}

	on_stream_event := func(ai_event_input) {
		sequence_value := normalize_non_negative_int(dict_get_or(stream_state, "sequence", 0), 0) + 1
		stream_state["sequence"] := sequence_value

		mapped := map_ai_stream_event_with_fallback(ai_event_input, run_id, agent_id, session_id, step_id, sequence_value, dict_get_or(stream_state, "runtime_services", runtime_services))
		stream_event := normalize_dict(dict_get_or(mapped, "event", {}))

		stream_events := normalize_array(dict_get_or(stream_state, "events", []))
		stream_events = push(stream_events, stream_event)
		stream_state["events"] := stream_events
		stream_state["runtime_services"] := dict_get_or(stream_event, "runtime_services", dict_get_or(stream_state, "runtime_services", runtime_services))

		if normalize_string(dict_get_or(stream_event, "kind", ""), "") == "guardrail_blocked" {
			stream_state["guardrail_blocked"] := true
			stream_state["guardrail_event"] := stream_event
		}

		event_callback := dict_get_or(options_map, "on_stream_event", null)
		if type(event_callback) == "function" {
			try {
				event_callback(stream_event)
			} except err {
				if normalize_string(dict_get_or(stream_state, "callback_error", ""), "") == "" {
					stream_state["callback_error"] := to_string(err)
				}
			}
		}
	}

	try {
		stream_state["stage"] := "call_chat_stream"
		model_result := call_chat_stream(ai_adapter, messages, request_options, on_stream_event)
		stream_state["stage"] := "collect_stream_state"
		runtime_services = dict_get_or(stream_state, "runtime_services", runtime_services)
		stream_events := normalize_array(dict_get_or(stream_state, "events", []))

		if len(stream_events) == 0 {
			stream_state["stage"] := "replay_emitted_events"
			try {
				raw_result := normalize_dict(dict_get_or(model_result, "raw", {}))
				emitted_events := normalize_array(dict_get_or(model_result, "emitted_events", dict_get_or(raw_result, "emitted_events", [])))
				event_callback := dict_get_or(options_map, "on_stream_event", null)

				index := 0
				total_events := len(emitted_events)
				while index < total_events {
					sequence_value := normalize_non_negative_int(dict_get_or(stream_state, "sequence", 0), 0) + 1
					stream_state["sequence"] := sequence_value
					mapped := map_ai_stream_event_with_fallback(emitted_events[index], run_id, agent_id, session_id, step_id, sequence_value, dict_get_or(stream_state, "runtime_services", runtime_services))
					stream_event := normalize_dict(dict_get_or(mapped, "event", {}))

					stream_events = push(stream_events, stream_event)
					stream_state["runtime_services"] := dict_get_or(stream_event, "runtime_services", dict_get_or(stream_state, "runtime_services", runtime_services))

					if normalize_string(dict_get_or(stream_event, "kind", ""), "") == "guardrail_blocked" {
						stream_state["guardrail_blocked"] := true
						stream_state["guardrail_event"] := stream_event
					}

					if type(event_callback) == "function" {
						try {
							event_callback(stream_event)
						} except err {
							if normalize_string(dict_get_or(stream_state, "callback_error", ""), "") == "" {
								stream_state["callback_error"] := to_string(err)
							}
						}
					}

					index = index + 1
				}

				stream_state["events"] := stream_events
			} except err {
				sequence_value := normalize_non_negative_int(dict_get_or(stream_state, "sequence", 0), 0) + 1
				stream_state["sequence"] := sequence_value
				synthetic_event := map_ai_sdk_stream_event({
					"type": "guardrail_blocked",
					"payload": {
						"reason": "emitted_events_mapping_failed"
					}
				}, {
					"run_id": run_id,
					"agent_id": agent_id,
					"session_id": session_id,
					"step_id": step_id,
					"sequence": sequence_value,
					"runtime_services": dict_get_or(stream_state, "runtime_services", runtime_services)
				})
				stream_events = push(stream_events, synthetic_event)
				stream_state["events"] := stream_events
				stream_state["guardrail_blocked"] := true
				stream_state["guardrail_event"] := synthetic_event
			}
		}

		stream_state["stage"] := "evaluate_callback_error"
		runtime_services = dict_get_or(stream_state, "runtime_services", runtime_services)
		callback_error := normalize_string(dict_get_or(stream_state, "callback_error", ""), "")

		if callback_error != "" {
			return {
				"model_result": {
					"ok": false,
					"error": create_agent_error("model_error", "Stream callback failed while processing model events.", {
						"details": {
							"error": callback_error
						}
					})
				},
				"model_attempts": 1,
				"model_retries_used": 0,
				"stream_events": stream_events,
				"runtime_services": runtime_services
			}
		}

		if dict_get_or(stream_state, "guardrail_blocked", false) {
			return {
				"model_result": {
					"ok": false,
					"error": create_agent_error("guardrail_blocked", "Streaming run was blocked by guardrail event.", {
						"details": {
							"event": clone_value(dict_get_or(stream_state, "guardrail_event", {}))
						}
					})
				},
				"model_attempts": 1,
				"model_retries_used": 0,
				"stream_events": stream_events,
				"runtime_services": runtime_services
			}
		}

		return {
			"model_result": model_result,
			"model_attempts": 1,
			"model_retries_used": 0,
			"stream_events": stream_events,
			"runtime_services": runtime_services
		}
	} except err {
		return {
			"model_result": {
				"ok": false,
				"error": create_agent_error("model_error", "Stream processing failed before completion.", {
					"details": {
						"stage": normalize_string(dict_get_or(stream_state, "stage", ""), ""),
						"error": to_string(err)
					}
				})
			},
			"model_attempts": 1,
			"model_retries_used": 0,
			"stream_events": normalize_array(dict_get_or(stream_state, "events", [])),
			"runtime_services": dict_get_or(stream_state, "runtime_services", runtime_services)
		}
	}
}

func create_agent_runner_impl(options) {
	options_map := normalize_dict(options)
	return {
		"type": "AgentRunner",
		"ai_adapter": dict_get_or(options_map, "ai_adapter", null),
		"handoff_registry": normalize_dict(dict_get_or(options_map, "handoff_registry", {})),
		"metadata": normalize_dict(dict_get_or(options_map, "metadata", {}))
	}
}

func build_model_messages(agent, run_request) {
	agent_map := normalize_dict(agent)
	run_request_map := normalize_dict(run_request)

	messages := normalize_array(dict_get_or(run_request_map, "messages", []))
	instructions := normalize_string(dict_get_or(agent_map, "instructions", ""), "")
	if instructions != "" {
		messages = push(messages, create_agent_message("system", instructions, {
			"source": "agent.instructions"
		}))
	}

	user_input := normalize_string(dict_get_or(run_request_map, "input", ""), "")
	if user_input != "" {
		messages = push(messages, create_agent_message("user", user_input, {
			"source": "run_request.input"
		}))
	}

	return messages
}

func as_run_request(run_request_input) {
	if type(run_request_input) == "dict" {
		return run_request_input
	}
	return create_agent_run_request(to_string(run_request_input), {})
}

func create_runner_error_result(run_status, error_payload, steps, metadata) {
	return create_agent_run_result(run_status, {
		"text": ""
	}, {
		"error": error_payload,
		"steps": steps,
		"metadata": metadata
	})
}

func create_runner_cancelled_result(cancelled_stage, steps, metadata) {
	stage_name := normalize_string(cancelled_stage, "unknown")
	error_payload := create_agent_error("cancelled", "Run cancelled at stage: " + stage_name + ".", {
		"details": {
			"cancelled_stage": stage_name
		}
	})

	return create_runner_error_result("cancelled", error_payload, steps, metadata)
}

func budget_check_passed(evaluation_input) {
	evaluation := normalize_dict(evaluation_input)
	if dict_get_or(evaluation, "ok", false) {
		return true
	}

	return normalize_string(dict_get_or(evaluation, "status", ""), "") == "exceeded_observe"
}

func append_budget_check_result(checks_input, stage_input, evaluation_input) {
	checks := normalize_array(checks_input)
	evaluation := normalize_dict(evaluation_input)
	return push(checks, {
		"stage": normalize_string(stage_input, "unknown"),
		"ok": budget_check_passed(evaluation),
		"status": normalize_string(dict_get_or(evaluation, "status", "unknown"), "unknown"),
		"evaluation": evaluation
	})
}

func build_budget_exceeded_error(stage_input, evaluation_input) {
	evaluation := normalize_dict(evaluation_input)
	error_payload := dict_get_or(evaluation, "error", null)
	if type(error_payload) == "dict" {
		return error_payload
	}

	return create_agent_error("budget_exceeded", "Run budget limits were exceeded.", {
		"details": {
			"stage": normalize_string(stage_input, "unknown"),
			"evaluation": evaluation
		}
	})
}

func create_budget_exceeded_result(stage_input, evaluation_input, steps, events, context, retrieval_state, retry_counters, session_restore_result, session_store_results, memory_store_results, artifact_store_results, budget_policy, budget_usage, budget_checks) {
	error_payload := build_budget_exceeded_error(stage_input, evaluation_input)

	return create_runner_error_result("budget_exceeded", error_payload, steps, {
		"events": events,
		"context": context,
		"retrieval": retrieval_state,
		"retry_counters": retry_counters,
		"session_store": {
			"restore": session_restore_result,
			"writes": session_store_results
		},
		"memory_store_writes": memory_store_results,
		"artifact_store_writes": artifact_store_results,
		"budget": {
			"policy": budget_policy,
			"usage": budget_usage,
			"checks": budget_checks,
			"last_evaluation": evaluation_input
		}
	})
}

func resolve_timeout_ms(options_map, run_request, agent_map) {
	from_options := dict_get_or(options_map, "timeout_ms", null)
	if type(from_options) == "int" {
		return normalize_non_negative_int(from_options, 0)
	}

	from_request := dict_get_or(run_request, "timeout_ms", null)
	if type(from_request) == "int" {
		return normalize_non_negative_int(from_request, 0)
	}

	from_agent := dict_get_or(agent_map, "timeout_ms", null)
	if type(from_agent) == "int" {
		return normalize_non_negative_int(from_agent, 0)
	}

	return 0
}

func current_elapsed_ms(started_ms_input, runtime_services_input) {
	started_ms := normalize_non_negative_int(started_ms_input, 0)
	now_ms := runtime_now_ms(runtime_services_input)
	if type(now_ms) == "int" {
		if now_ms >= started_ms {
			return now_ms - started_ms
		}
	}
	return 0
}

func with_elapsed_budget_usage(usage_input, elapsed_ms_input) {
	usage := create_budget_usage(usage_input)
	counters := normalize_dict(dict_get_or(usage, "counters", {}))
	counters["elapsed_ms"] := normalize_non_negative_int(elapsed_ms_input, 0)

	return create_budget_usage({
		"run_id": normalize_string(dict_get_or(usage, "run_id", ""), ""),
		"counters": counters,
		"metadata": dict_get_or(usage, "metadata", {})
	})
}

func evaluate_timeout_boundary(stage_input, timeout_ms_input, elapsed_ms_input) {
	timeout_ms := normalize_non_negative_int(timeout_ms_input, 0)
	elapsed_ms := normalize_non_negative_int(elapsed_ms_input, 0)
	exceeded := false
	if timeout_ms > 0 {
		if elapsed_ms > timeout_ms {
			exceeded = true
		}
	}
	status := "within_timeout"
	if exceeded {
		status = "timeout_exceeded"
	}

	return {
		"stage": normalize_string(stage_input, "unknown"),
		"timeout_ms": timeout_ms,
		"elapsed_ms": elapsed_ms,
		"exceeded": exceeded,
		"status": status
	}
}

func create_timeout_result(stage_input, timeout_check_input, steps, events, context, retrieval_state, retry_counters, session_restore_result, session_store_results, memory_store_results, artifact_store_results, budget_policy, budget_usage, budget_checks, timeout_checks) {
	timeout_check := normalize_dict(timeout_check_input)
	error_payload := create_agent_error("timeout", "Run exceeded configured timeout deadline.", {
		"details": {
			"stage": normalize_string(stage_input, "unknown"),
			"timeout_ms": normalize_non_negative_int(dict_get_or(timeout_check, "timeout_ms", 0), 0),
			"elapsed_ms": normalize_non_negative_int(dict_get_or(timeout_check, "elapsed_ms", 0), 0)
		}
	})

	return create_runner_error_result("timeout", error_payload, steps, {
		"events": events,
		"context": context,
		"retrieval": retrieval_state,
		"retry_counters": retry_counters,
		"session_store": {
			"restore": session_restore_result,
			"writes": session_store_results
		},
		"memory_store_writes": memory_store_results,
		"artifact_store_writes": artifact_store_results,
		"budget": {
			"policy": budget_policy,
			"usage": budget_usage,
			"checks": budget_checks
		},
		"timeout": {
			"checks": timeout_checks,
			"last_check": timeout_check
		}
	})
}

func create_max_iterations_result(stage_input, max_iterations, steps_count, steps, events, context, retrieval_state, retry_counters, session_restore_result, session_store_results, memory_store_results, artifact_store_results, budget_policy, budget_usage, budget_checks, timeout_ms, timeout_checks) {
	error_payload := create_agent_error("internal_error", "Run reached the configured max iterations limit.", {
		"details": {
			"stop_reason": "max_iterations",
			"stage": normalize_string(stage_input, "unknown"),
			"max_iterations": normalize_non_negative_int(max_iterations, 0),
			"steps_count": normalize_non_negative_int(steps_count, 0)
		}
	})

	return create_runner_error_result("max_iterations", error_payload, steps, {
		"events": events,
		"context": context,
		"retrieval": retrieval_state,
		"retry_counters": retry_counters,
		"session_store": {
			"restore": session_restore_result,
			"writes": session_store_results
		},
		"memory_store_writes": memory_store_results,
		"artifact_store_writes": artifact_store_results,
		"budget": {
			"policy": budget_policy,
			"usage": budget_usage,
			"checks": budget_checks
		},
		"timeout": {
			"timeout_ms": timeout_ms,
			"checks": timeout_checks
		}
	})
}

func push_cancelled_event(events, run_id, agent_id, session_id, step_id, cancelled_stage, runtime_services) {
	run_cancelled := create_agent_event("run_cancelled", {
		"cancelled_stage": normalize_string(cancelled_stage, "unknown")
	}, {
		"run_id": run_id,
		"agent_id": agent_id,
		"session_id": session_id,
		"step_id": normalize_string(step_id, ""),
		"runtime_services": runtime_services
	})

	return {
		"events": push(events, run_cancelled),
		"runtime_services": dict_get_or(run_cancelled, "runtime_services", runtime_services)
	}
}

