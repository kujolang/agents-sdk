func resolve_tool_approval_provider(runner_map, options_map, run_request) {
	from_options := dict_get_or(options_map, "approval_provider", null)
	if type(from_options) == "dict" {
		provider_kind := normalize_string(dict_get_or(from_options, "kind", "auto"), "auto")
		if provider_kind == "deny_all" {
			return create_deny_all_approval_provider(from_options)
		}
		return create_auto_approval_provider(from_options)
	}

	from_request := dict_get_or(run_request, "approval_provider", null)
	if type(from_request) == "dict" {
		provider_kind := normalize_string(dict_get_or(from_request, "kind", "auto"), "auto")
		if provider_kind == "deny_all" {
			return create_deny_all_approval_provider(from_request)
		}
		return create_auto_approval_provider(from_request)
	}

	from_runner := dict_get_or(runner_map, "approval_provider", null)
	if type(from_runner) == "dict" {
		provider_kind := normalize_string(dict_get_or(from_runner, "kind", "auto"), "auto")
		if provider_kind == "deny_all" {
			return create_deny_all_approval_provider(from_runner)
		}
		return create_auto_approval_provider(from_runner)
	}

	return null
}

