func resolve_budget_policy(runner_map, options_map, run_request, agent_map) {
	from_options := dict_get_or(options_map, "budget_policy", null)
	if type(from_options) == "dict" {
		return create_budget_limit_policy(from_options)
	}

	from_request := dict_get_or(run_request, "budget_policy", null)
	if type(from_request) == "dict" {
		return create_budget_limit_policy(from_request)
	}

	from_runner := dict_get_or(runner_map, "budget_policy", null)
	if type(from_runner) == "dict" {
		return create_budget_limit_policy(from_runner)
	}

	agent_budget := normalize_dict(dict_get_or(agent_map, "budget", {}))
	if len(keys(agent_budget)) > 0 {
		return create_budget_limit_policy({
			"mode": "enforce",
			"budget": agent_budget
		})
	}

	return create_budget_limit_policy({
		"mode": "enforce",
		"budget": {}
	})
}

