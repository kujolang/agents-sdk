func watchdog_transform_trace_event_impl(adapter_input, trace_event_input, options) {
	adapter := normalize_dict(adapter_input)
	trace_event := normalize_dict(trace_event_input)
	transform_trace_fn := dict_get_or(adapter, "transform_trace_fn", null)

	if type(transform_trace_fn) == "function" {
		return transform_trace_fn(trace_event, normalize_dict(options))
	}

	return {
		"ok": true,
		"record": {
			"trace_id": normalize_string(dict_get_or(trace_event, "trace_id", ""), ""),
			"run_id": normalize_string(dict_get_or(trace_event, "run_id", ""), ""),
			"agent_id": normalize_string(dict_get_or(trace_event, "agent_id", ""), ""),
			"event_kind": normalize_string(dict_get_or(trace_event, "event_kind", "run_failed"), "run_failed"),
			"timestamp": normalize_string(dict_get_or(trace_event, "timestamp", ""), ""),
			"sequence": dict_get_or(trace_event, "sequence", 0),
			"payload": clone_value(dict_get_or(trace_event, "payload", {})),
			"metadata": {
				"source": "agents.trace",
				"adapter": "watchdog",
				"version": "0.1.0"
			}
		}
	}
}

