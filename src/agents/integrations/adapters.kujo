		"provider_name": normalize_string(dict_get_or(options_map, "provider_name", "scout"), "scout"),
		"resolve_context_fn": dict_get_or(options_map, "resolve_context_fn", null),
		"metadata": clone_value(dict_get_or(options_map, "metadata", {}))
	}
}

func normalize_scout_context_entry_impl(entry_input, default_id_input) {
	entry := normalize_dict(entry_input)
	entry_id := normalize_string(dict_get_or(entry, "entry_id", default_id_input), default_id_input)
	file_path := normalize_string(dict_get_or(entry, "file_path", dict_get_or(entry, "path", "")), "")
	symbol_name := normalize_string(dict_get_or(entry, "symbol_name", dict_get_or(entry, "symbol", "")), "")
	title := normalize_string(dict_get_or(entry, "title", symbol_name), symbol_name)
	if title == "" {
		title = file_path
	}
	if title == "" {
		title = entry_id
	}

	return {
		"entry_id": entry_id,
		"file_path": file_path,
		"symbol_name": symbol_name,
		"title": title,
		"snippet": normalize_string(dict_get_or(entry, "snippet", dict_get_or(entry, "content", "")), ""),
		"score": dict_get_or(entry, "score", 0),
		"start_line": dict_get_or(entry, "start_line", 0),
		"end_line": dict_get_or(entry, "end_line", 0),
		"metadata": clone_value(dict_get_or(entry, "metadata", {}))
	}
}

func create_scout_context_payload_impl(provider_name_input, request_input, raw_result_input) {
	provider_name := normalize_string(provider_name_input, "scout")
	request := normalize_dict(request_input)
	raw_result := normalize_dict(raw_result_input)
	entries_input := normalize_array(dict_get_or(raw_result, "entries", dict_get_or(raw_result, "contexts", [])))
	entries := []
	entry_index := 0

	while entry_index < len(entries_input) {
		entry_value := entries_input[entry_index]
		default_id := "ctx-" + to_string(entry_index + 1)
		entries = push(entries, normalize_scout_context_entry_impl(entry_value, default_id))
		entry_index = entry_index + 1
	}

	summary := normalize_string(dict_get_or(raw_result, "summary", ""), "")
	if summary == "" {
		summary = normalize_string(dict_get_or(request, "query_text", ""), "")
	}

	query_text := normalize_string(dict_get_or(request, "query_text", ""), "")

	return {
		"ok": true,
		"context": {
			"provider_name": provider_name,
			"query_text": query_text,
			"entries": entries,
			"summary": summary,
			"metadata": clone_value(dict_get_or(raw_result, "metadata", {}))
		},
		"count": len(entries),
		"metadata": {
			"integration_provider": "scout",
			"provider_name": provider_name,
			"query_text": query_text,
			"entry_count": len(entries),
			"adapter_version": "0.1.0"
		}
	}
}

func scout_provider_resolve_context_impl(provider_input, query_input, options) {
	provider := normalize_dict(provider_input)
	resolve_context_fn := dict_get_or(provider, "resolve_context_fn", null)
	if type(resolve_context_fn) != "function" {
		return {
			"ok": false,
			"error": {
				"kind": "not_implemented",
				"message": "Scout code-context provider does not expose resolve_context_fn.",
				"details": {
					"provider_name": normalize_string(dict_get_or(provider, "provider_name", "scout"), "scout")
				}
			}
		}
	}

	query_map := normalize_dict(query_input)
	query_text := normalize_string(dict_get_or(query_map, "query_text", dict_get_or(query_map, "query", "")), "")
	if query_text == "" {
		return {
			"ok": false,
			"error": {
				"kind": "invalid_request",
				"message": "Scout code-context query_text is required.",
				"details": {
					"field": "query_text"
				}
			}
		}
	}

	request_payload := {
		"query_text": query_text,
		"path_hints": clone_value(dict_get_or(query_map, "path_hints", [])),
		"language_hint": normalize_string(dict_get_or(query_map, "language_hint", ""), ""),
		"top_k": dict_get_or(query_map, "top_k", 5),
		"metadata": clone_value(dict_get_or(query_map, "metadata", {}))
	}

	raw_result := resolve_context_fn(provider, request_payload, normalize_dict(options))
	if type(raw_result) != "dict" {
		return {
			"ok": false,
			"error": {
				"kind": "integration_error",
				"message": "Scout code-context provider returned an invalid payload.",
				"details": {
					"provider_name": normalize_string(dict_get_or(provider, "provider_name", "scout"), "scout")
				}
			}
		}
	}

	if dict_get_or(raw_result, "ok", true) == false {
		return raw_result
	}

	provider_name := normalize_string(dict_get_or(provider, "provider_name", "scout"), "scout")
	return create_scout_context_payload_impl(provider_name, request_payload, raw_result)
}

func map_scout_context_to_retrieval_enrichment_impl(context_result_input, options) {
	context_result := normalize_dict(context_result_input)
	if dict_get_or(context_result, "ok", true) == false {
		return context_result
	}

	context := normalize_dict(dict_get_or(context_result, "context", context_result))
	entries_input := normalize_array(dict_get_or(context, "entries", []))
	documents := []
	citations := []
	entry_index := 0

	while entry_index < len(entries_input) {
		entry := normalize_dict(entries_input[entry_index])
		document_id := normalize_string(dict_get_or(entry, "document_id", "scout-doc-" + to_string(entry_index + 1)), "scout-doc-" + to_string(entry_index + 1))
		entry_id := normalize_string(dict_get_or(entry, "entry_id", "ctx-" + to_string(entry_index + 1)), "ctx-" + to_string(entry_index + 1))
		file_path := normalize_string(dict_get_or(entry, "file_path", ""), "")
		symbol_name := normalize_string(dict_get_or(entry, "symbol_name", ""), "")
		title := normalize_string(dict_get_or(entry, "title", symbol_name), symbol_name)
		if title == "" {
			title = file_path
		}

		doc_metadata := {
			"integration_provider": "scout",
			"entry_id": entry_id,
			"file_path": file_path,
			"symbol_name": symbol_name,
			"start_line": dict_get_or(entry, "start_line", 0),
			"end_line": dict_get_or(entry, "end_line", 0)
		}
		documents = push(documents, {
			"document_id": document_id,
			"title": title,
			"content": normalize_string(dict_get_or(entry, "snippet", ""), ""),
			"score": dict_get_or(entry, "score", 0),
			"source": file_path,
			"metadata": doc_metadata
		})
		citations = push(citations, {
			"citation_id": "scout-citation-" + to_string(entry_index + 1),
			"document_id": document_id,
			"span": file_path,
			"score": dict_get_or(entry, "score", 0),
			"metadata": doc_metadata
		})

		entry_index = entry_index + 1
	}

	return {
		"ok": true,
		"retrieval_enrichment": {
			"documents": documents,
			"citations": citations,
			"summary": normalize_string(dict_get_or(context, "summary", ""), ""),
			"metadata": {
				"integration_provider": "scout",
				"provider_name": normalize_string(dict_get_or(context, "provider_name", "scout"), "scout"),
				"query_text": normalize_string(dict_get_or(context, "query_text", ""), ""),
				"entry_count": len(documents),
				"adapter_version": "0.1.0"
			}
		}
	}
}

func describe_integration_adapters_module_impl() {
	return {
		"module": "agents.integrations.adapters",
		"status": "active",
		"contract_version": "0.1.0",
		"exports": [
			"mcp_2026_protocol_version",
			"create_mcp_2026_request_meta",
			"create_mcp_2026_jsonrpc_request",
			"create_mcp_2026_discover_request",
			"create_mcp_2026_list_tools_request",
			"create_mcp_2026_call_tool_request",
			"normalize_mcp_2026_list_tools_result",
			"normalize_mcp_2026_call_tool_result",
			"create_mcp_2026_unsupported_protocol_error",
			"map_mcp_2026_tool_to_registry_entry",
			"create_external_tool_provider_adapter",
			"external_provider_list_tools",
			"external_provider_invoke_tool",
			"map_external_tool_to_registry_entry",
			"create_dispatch_integration_hooks",
			"dispatch_run_agent_step",
			"dispatch_invoke_workflow_as_tool",
			"create_watchdog_trace_adapter",
			"watchdog_transform_trace_event",
			"create_scout_code_context_provider",
			"scout_provider_resolve_context",
			"map_scout_context_to_retrieval_enrichment"
		]
	}
}

