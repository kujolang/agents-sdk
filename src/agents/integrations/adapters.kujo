func dict_get_or(obj, key, default_value) {
	if type(obj) != "dict" {
		return default_value
	}
	if has_key(obj, key) {
		return obj[key]
	}
	return default_value
}

func normalize_dict(value) {
	if type(value) == "dict" {
		return value
	}
	return {}
}

func normalize_array(value) {
	if type(value) == "array" {
		return value
	}
	return []
}

func normalize_string(value, fallback) {
	if type(value) == "string" {
		trimmed := trim(value)
		if trimmed != "" {
			return trimmed
		}
	}
	return fallback
}

func clone_value(value) {
	if type(value) == "dict" {
		source := normalize_dict(value)
		cloned := {}
		for key in keys(source) {
			cloned[key] := clone_value(source[key])
		}
		return cloned
	}

	if type(value) == "array" {
		cloned := []
		for item in value {
			cloned = push(cloned, clone_value(item))
		}
		return cloned
	}

	return value
}

func create_external_tool_provider_adapter_impl(options) {
	options_map := normalize_dict(options)

	return {
		"type": "ExternalToolProviderAdapter",
		"provider_name": normalize_string(dict_get_or(options_map, "provider_name", "external"), "external"),
		"list_tools_fn": dict_get_or(options_map, "list_tools_fn", null),
		"invoke_tool_fn": dict_get_or(options_map, "invoke_tool_fn", null),
		"metadata": clone_value(dict_get_or(options_map, "metadata", {}))
	}
}

func external_provider_list_tools_impl(provider_input, options) {
	provider := normalize_dict(provider_input)
	list_tools_fn := dict_get_or(provider, "list_tools_fn", null)
	if type(list_tools_fn) != "function" {
		return {
			"ok": false,
			"error": {
				"kind": "not_implemented",
				"message": "External tool provider does not expose list_tools_fn.",
				"details": {
					"provider_name": normalize_string(dict_get_or(provider, "provider_name", "external"), "external")
				}
			}
		}
	}

	tools := list_tools_fn(provider, normalize_dict(options))

	return {
		"ok": true,
		"tools": normalize_array(tools)
	}
}

func external_provider_invoke_tool_impl(provider_input, tool_name_input, input_payload, context_input) {
	provider := normalize_dict(provider_input)
	invoke_tool_fn := dict_get_or(provider, "invoke_tool_fn", null)
	if type(invoke_tool_fn) != "function" {
		return {
			"ok": false,
			"error": {
				"kind": "not_implemented",
				"message": "External tool provider does not expose invoke_tool_fn.",
				"details": {
					"provider_name": normalize_string(dict_get_or(provider, "provider_name", "external"), "external")
				}
			}
		}
	}

	tool_name := normalize_string(tool_name_input, "")
	if tool_name == "" {
		return {
			"ok": false,
			"error": {
				"kind": "invalid_request",
				"message": "Tool name is required for provider invocation.",
				"details": {}
			}
		}
	}

	return invoke_tool_fn(provider, tool_name, normalize_dict(input_payload), normalize_dict(context_input))
}

func map_external_tool_to_registry_entry_impl(external_tool_input, options) {
	external_tool := normalize_dict(external_tool_input)
	options_map := normalize_dict(options)
	provider_name := normalize_string(dict_get_or(options_map, "provider_name", dict_get_or(external_tool, "provider_name", "external")), "external")
	tool_name := normalize_string(dict_get_or(external_tool, "name", dict_get_or(external_tool, "tool_name", "external_tool")), "external_tool")
	tool_id := normalize_string(dict_get_or(external_tool, "id", provider_name + "." + tool_name), provider_name + "." + tool_name)

	return {
		"id": tool_id,
		"name": tool_name,
		"description": normalize_string(dict_get_or(external_tool, "description", "External provider tool"), "External provider tool"),
		"input_schema": clone_value(dict_get_or(external_tool, "input_schema", {})),
		"output_schema": clone_value(dict_get_or(external_tool, "output_schema", {})),
		"permissions": clone_value(dict_get_or(external_tool, "permissions", [])),
		"risk_level": normalize_string(dict_get_or(external_tool, "risk_level", "medium"), "medium"),
		"timeout_ms": dict_get_or(external_tool, "timeout_ms", 0),
		"metadata": {
			"integration_provider": provider_name,
			"integration_kind": "external_tool_provider",
			"approval_required": dict_get_or(external_tool, "approval_required", false),
			"external_contract": clone_value(external_tool)
		}
	}
}

