from src.agents.events import event_kind_values
from src.agents.runtime.clock_ids import create_runtime_services, next_runtime_id, runtime_now_iso

func dict_get_or(obj, key, default_value) {
	source := unwrap_dict(obj)
	if type(source) != "dict" {
		return default_value
	}

	if has_key(source, key) {
		return source[key]
	}

	return default_value
}

func unwrap_dict(value) {
	if type(value) != "dict" {
		return value
	}

	if has_key(value, "_self") {
		inner := value["_self"]
		if type(inner) == "dict" {
			return inner
		}
	}

	return value
}

func normalize_dict(value) {
	unwrapped := unwrap_dict(value)
	if type(unwrapped) == "dict" {
		return unwrapped
	}
	return {}
}

func normalize_string(value, fallback) {
	if type(value) == "string" {
		trimmed := trim(value)
		if trimmed != "" {
			return trimmed
		}
	}
	return fallback
}

func normalize_text(value, fallback) {
	if type(value) == "string" {
		trimmed := trim(value)
		if trimmed != "" {
			return trimmed
		}
	}

	if type(value) != "dict" && type(value) != "array" && type(value) != "null" {
		coerced := trim(to_string(value))
		if coerced != "" {
			return coerced
		}
	}

	return fallback
}

func normalize_non_negative_int(value, fallback) {
	if type(value) == "int" {
		if value >= 0 {
			return value
		}
	}
	return fallback
}

func normalize_bool(value, fallback) {
	if type(value) == "bool" {
		return value
	}
	return fallback
}

func contains_traversal_segment(path_input) {
	path_value := normalize_string(path_input, "")
	if path_value == "" {
		return false
	}

	if contains(path_value, "..") >= 0 {
		return true
	}

	if contains(path_value, "\\") >= 0 {
		return true
	}

	return false
}

func resolve_jsonl_trace_file_path(sink_input) {
	sink := normalize_dict(sink_input)
	metadata := normalize_dict(dict_get_or(sink, "metadata", {}))
	root_path := normalize_string(dict_get_or(metadata, "root_path", ""), "")
	file_name := normalize_string(dict_get_or(metadata, "file_name", "trace.jsonl"), "trace.jsonl")

	if root_path == "" {
		return {
			"ok": false,
			"error": {
				"kind": "invalid_path",
				"message": "JSONL trace sink root path is required.",
				"details": {
					"field": "root_path"
				}
			}
		}
	}

	if contains_traversal_segment(file_name) || contains(file_name, "/") >= 0 {
		return {
			"ok": false,
			"error": {
				"kind": "invalid_path",
				"message": "JSONL trace sink file name must be a safe leaf file.",
				"details": {
					"file_name": file_name
				}
			}
		}
	}

	return {
		"ok": true,
		"file_path": root_path + "/" + file_name,
		"root_path": root_path,
		"file_name": file_name
	}
}

func normalize_string_array(values_input) {
	values := values_input
	if type(values_input) != "array" {
		values = []
	}

	normalized := []
	index := 0
	total := len(values)
	while index < total {
		value_text := normalize_text(values[index], "")
		if value_text != "" {
			normalized = push(normalized, value_text)
		}
		index = index + 1
	}

	return normalized
}

func string_array_contains(values_input, expected_input) {
	values := normalize_string_array(values_input)
	expected := normalize_text(expected_input, "")
	if expected == "" {
		return false
	}

	index := 0
	total := len(values)
	while index < total {
		if normalize_text(values[index], "") == expected {
			return true
		}
		index = index + 1
	}

	return false
}

func apply_trace_redaction_policy(trace_input, options_input) {
	trace := to_trace_record(trace_input)
	options_map := normalize_dict(options_input)
	policy := normalize_dict(dict_get_or(options_map, "redaction_policy", {}))
	if len(keys(policy)) == 0 {
		return {
			"trace": trace,
			"redaction": {
				"applied": false,
				"redacted_field_count": 0,
				"truncated_field_count": 0,
				"transformed_field_count": 0
			}
		}
	}

	fields_to_redact := normalize_string_array(dict_get_or(policy, "fields_to_redact", []))
	max_string_length := normalize_non_negative_int(dict_get_or(policy, "max_string_length", 0), 0)
	replacement := normalize_string(dict_get_or(policy, "replacement", "[REDACTED]"), "[REDACTED]")
	payload := normalize_dict(dict_get_or(trace, "payload", {}))
	redacted_field_count := 0
	truncated_field_count := 0

	for payload_key in keys(payload) {
		current_value := payload[payload_key]

		if string_array_contains(fields_to_redact, payload_key) {
			payload[payload_key] = replacement
			redacted_field_count = redacted_field_count + 1
		} else if max_string_length > 0 && type(current_value) == "string" {
			current_text := to_string(current_value)
			if len(current_text) > max_string_length {
				payload[payload_key] = substring(current_text, 0, max_string_length)
				truncated_field_count = truncated_field_count + 1
			}
		}
	}

	trace["payload"] := payload
	redaction_applied := false
	if redacted_field_count > 0 || truncated_field_count > 0 {
		redaction_applied = true
	}
	redaction := {
		"applied": redaction_applied,
		"redacted_field_count": redacted_field_count,
		"truncated_field_count": truncated_field_count,
		"transformed_field_count": redacted_field_count + truncated_field_count
	}

	metadata := normalize_dict(dict_get_or(trace, "metadata", {}))
	metadata["redaction"] := redaction
	trace["metadata"] := metadata

	return {
		"trace": trace,
		"redaction": redaction
	}
}

func clone_value(value) {
	if type(value) == "dict" {
		source := normalize_dict(value)
		cloned := {}
		for key in keys(source) {
			cloned[key] := clone_value(source[key])
		}
		return cloned
	}

	if type(value) == "array" {
		cloned := []
		for item in value {
			cloned = push(cloned, clone_value(item))
		}
		return cloned
	}

	return value
}

func array_contains(values_input, expected) {
	values := values_input
	if type(values_input) != "array" {
		values = []
	}

	index := 0
	total := len(values)
	while index < total {
		if values[index] == expected {
			return true
		}
		index = index + 1
	}

	return false
}

func trace_required_fields_impl() {
	return [
		"type",
		"trace_id",
		"run_id",
		"agent_id",
		"session_id",
		"step_id",
		"event_kind",
		"timestamp",
		"sequence",
		"payload",
		"metadata"
	]
}

func resolve_trace_event_kind(kind_input, payload_input) {
	requested_kind := normalize_string(kind_input, "run_failed")
	payload := normalize_dict(payload_input)

	if array_contains(event_kind_values(), requested_kind) {
		return {
			"event_kind": requested_kind,
			"payload": payload
		}
	}

	payload["requested_event_kind"] := requested_kind
	return {
		"event_kind": "run_failed",
		"payload": payload
	}
}

func create_trace_event_impl(event_kind_input, payload_input, options) {
	options_map := normalize_dict(options)
	runtime_services := dict_get_or(options_map, "runtime_services", create_runtime_services({}))

	trace_id := normalize_string(dict_get_or(options_map, "trace_id", ""), "")
	if trace_id == "" {
		id_result := next_runtime_id(runtime_services, "trc")
		trace_id = normalize_string(dict_get_or(id_result, "id", "trc-0"), "trc-0")
		runtime_services = dict_get_or(id_result, "runtime_services", runtime_services)
	}

	kind_result := resolve_trace_event_kind(event_kind_input, payload_input)

	return {
		"type": "TraceEvent",
		"trace_id": trace_id,
		"run_id": normalize_string(dict_get_or(options_map, "run_id", ""), ""),
		"agent_id": normalize_string(dict_get_or(options_map, "agent_id", ""), ""),
		"session_id": normalize_string(dict_get_or(options_map, "session_id", ""), ""),
		"step_id": normalize_string(dict_get_or(options_map, "step_id", ""), ""),
		"event_kind": normalize_string(dict_get_or(kind_result, "event_kind", "run_failed"), "run_failed"),
		"timestamp": normalize_string(dict_get_or(options_map, "timestamp", ""), runtime_now_iso(runtime_services)),
		"sequence": normalize_non_negative_int(dict_get_or(options_map, "sequence", 0), 0),
		"payload": normalize_dict(dict_get_or(kind_result, "payload", {})),
		"metadata": clone_value(dict_get_or(options_map, "metadata", {})),
		"runtime_services": runtime_services
	}
}

func validate_trace_event_shape_impl(event_input) {
	event_map := normalize_dict(event_input)
	errors := []

	for field_name in trace_required_fields_impl() {
		if has_key(event_map, field_name) == 0 {
			errors = push(errors, {
				"field": field_name,
				"message": "Missing required trace event field."
			})
		}
	}

	event_kind := normalize_string(dict_get_or(event_map, "event_kind", ""), "")
	if event_kind == "" || array_contains(event_kind_values(), event_kind) == false {
		errors = push(errors, {
			"field": "event_kind",
			"message": "Trace event kind must be one of the supported event kinds."
		})
	}

	return {
		"ok": len(errors) == 0,
		"errors": errors
	}
}

func create_trace_sink_interface_impl(options) {
	options_map := normalize_dict(options)

	return {
		"type": "TraceSink",
		"name": normalize_string(dict_get_or(options_map, "name", "TraceSink"), "TraceSink"),
		"append_trace_fn": dict_get_or(options_map, "append_trace_fn", null),
		"list_traces_fn": dict_get_or(options_map, "list_traces_fn", null),
		"metadata": clone_value(dict_get_or(options_map, "metadata", {}))
	}
}

IN_MEMORY_TRACE_SINKS := {}

func resolve_trace_store_id(sink_input) {
	sink := normalize_dict(sink_input)
	metadata := normalize_dict(dict_get_or(sink, "metadata", {}))
	store_id := normalize_string(dict_get_or(metadata, "store_id", ""), "")
	if store_id != "" {
		return store_id
	}

	return normalize_string(dict_get_or(sink, "name", "in-memory-trace-sink"), "in-memory-trace-sink")
}

func default_in_memory_trace_state() {
	return {
		"traces_by_id": {},
		"ordered_trace_ids": [],
		"next_sequence": 1
	}
}

func ensure_in_memory_trace_state(store_id_input) {
	store_id := normalize_string(store_id_input, "in-memory-trace-sink")
	if has_key(IN_MEMORY_TRACE_SINKS, store_id) {
		return normalize_dict(dict_get_or(IN_MEMORY_TRACE_SINKS, store_id, {}))
	}

	state := default_in_memory_trace_state()
	IN_MEMORY_TRACE_SINKS[store_id] := state
	return state
}

func save_in_memory_trace_state(store_id_input, state_input) {
	store_id := normalize_string(store_id_input, "in-memory-trace-sink")
	IN_MEMORY_TRACE_SINKS[store_id] := normalize_dict(state_input)
}

func matches_trace_filter(trace_input, filter_input) {
	trace := normalize_dict(trace_input)
	filter_map := normalize_dict(filter_input)

	run_id_filter := normalize_string(dict_get_or(filter_map, "run_id", ""), "")
	if run_id_filter != "" {
		if normalize_string(dict_get_or(trace, "run_id", ""), "") != run_id_filter {
			return false
		}
	}

	agent_id_filter := normalize_string(dict_get_or(filter_map, "agent_id", ""), "")
	if agent_id_filter != "" {
		if normalize_string(dict_get_or(trace, "agent_id", ""), "") != agent_id_filter {
			return false
		}
	}

	session_id_filter := normalize_string(dict_get_or(filter_map, "session_id", ""), "")
	if session_id_filter != "" {
		if normalize_string(dict_get_or(trace, "session_id", ""), "") != session_id_filter {
			return false
		}
	}

	step_id_filter := normalize_string(dict_get_or(filter_map, "step_id", ""), "")
	if step_id_filter != "" {
		if normalize_string(dict_get_or(trace, "step_id", ""), "") != step_id_filter {
			return false
		}
	}

	event_kind_filter := normalize_string(dict_get_or(filter_map, "event_kind", ""), "")
	if event_kind_filter != "" {
		if normalize_string(dict_get_or(trace, "event_kind", ""), "") != event_kind_filter {
			return false
		}
	}

	return true
}

func to_trace_record(trace_input) {
	trace := normalize_dict(trace_input)

	return {
		"type": normalize_string(dict_get_or(trace, "type", "TraceEvent"), "TraceEvent"),
		"trace_id": normalize_string(dict_get_or(trace, "trace_id", ""), ""),
		"run_id": normalize_string(dict_get_or(trace, "run_id", ""), ""),
		"agent_id": normalize_string(dict_get_or(trace, "agent_id", ""), ""),
		"session_id": normalize_string(dict_get_or(trace, "session_id", ""), ""),
		"step_id": normalize_string(dict_get_or(trace, "step_id", ""), ""),
		"event_kind": normalize_string(dict_get_or(trace, "event_kind", "run_failed"), "run_failed"),
		"timestamp": normalize_string(dict_get_or(trace, "timestamp", ""), ""),
		"sequence": normalize_non_negative_int(dict_get_or(trace, "sequence", 0), 0),
		"payload": normalize_dict(dict_get_or(trace, "payload", {})),
		"metadata": normalize_dict(dict_get_or(trace, "metadata", {}))
	}
}

func in_memory_append_trace_fn_impl(sink_input, trace_input, options) {
	store_id := resolve_trace_store_id(sink_input)
	state := ensure_in_memory_trace_state(store_id)
	traces_by_id := normalize_dict(dict_get_or(state, "traces_by_id", {}))
	ordered_trace_ids := dict_get_or(state, "ordered_trace_ids", [])
	if type(ordered_trace_ids) != "array" {
		ordered_trace_ids = []
	}
	next_sequence := normalize_non_negative_int(dict_get_or(state, "next_sequence", 1), 1)

	trace := to_trace_record(trace_input)
	trace_id := normalize_string(dict_get_or(trace, "trace_id", ""), "")
	if trace_id == "" {
		trace_id = store_id + "-trace-" + to_string(next_sequence)
	}

	if has_key(traces_by_id, trace_id) {
		trace_id = store_id + "-trace-" + to_string(next_sequence)
		while has_key(traces_by_id, trace_id) {
			next_sequence = next_sequence + 1
			trace_id = store_id + "-trace-" + to_string(next_sequence)
		}
	}

	sequence := normalize_non_negative_int(dict_get_or(trace, "sequence", 0), 0)
	if sequence <= 0 {
		sequence = next_sequence
	}

	ordered_trace_ids = push(ordered_trace_ids, trace_id)

	trace["trace_id"] := trace_id
	trace["sequence"] := sequence
	traces_by_id[trace_id] := trace

	state["traces_by_id"] := traces_by_id
	state["ordered_trace_ids"] := ordered_trace_ids
	if sequence >= next_sequence {
		next_sequence = sequence + 1
	}
	state["next_sequence"] := next_sequence
	save_in_memory_trace_state(store_id, state)

	return {
		"ok": true,
		"trace": to_trace_record(trace),
		"count": len(ordered_trace_ids)
	}
}

func in_memory_list_traces_fn_impl(sink_input, options) {
	store_id := resolve_trace_store_id(sink_input)
	state := ensure_in_memory_trace_state(store_id)
	traces_by_id := normalize_dict(dict_get_or(state, "traces_by_id", {}))
	ordered_trace_ids := dict_get_or(state, "ordered_trace_ids", [])
	if type(ordered_trace_ids) != "array" {
		ordered_trace_ids = []
	}
	filter_map := normalize_dict(options)

	filtered := []
	index := 0
	total_ids := len(ordered_trace_ids)
	while index < total_ids {
		trace_id := normalize_string(ordered_trace_ids[index], "")
		if trace_id != "" {
			if has_key(traces_by_id, trace_id) {
				trace := normalize_dict(dict_get_or(traces_by_id, trace_id, {}))
				if len(keys(trace)) > 0 {
					if matches_trace_filter(trace, filter_map) {
						filtered = push(filtered, to_trace_record(trace))
					}
				}
			}
		}
		index = index + 1
	}

	offset := normalize_non_negative_int(dict_get_or(filter_map, "offset", 0), 0)
	limit := normalize_non_negative_int(dict_get_or(filter_map, "limit", len(filtered)), len(filtered))
	if limit <= 0 {
		limit = len(filtered)
	}

	items := []
	cursor := offset
	max_items := offset + limit
	if max_items > len(filtered) {
		max_items = len(filtered)
	}

	while cursor < max_items {
		items = push(items, filtered[cursor])
		cursor = cursor + 1
	}

	return {
		"ok": true,
		"traces": items,
		"count": len(filtered),
		"total_count": len(filtered)
	}
}

func create_in_memory_trace_sink_impl(options) {
	options_map := normalize_dict(options)
	store_id := normalize_string(dict_get_or(options_map, "store_id", "in-memory-trace-sink"), "in-memory-trace-sink")
	metadata := clone_value(dict_get_or(options_map, "metadata", {}))
	metadata["store_kind"] := "in_memory"
	metadata["store_id"] := store_id

	ensure_in_memory_trace_state(store_id)

	return create_trace_sink_interface_impl({
		"name": normalize_string(dict_get_or(options_map, "name", "InMemoryTraceSink"), "InMemoryTraceSink"),
		"append_trace_fn": in_memory_append_trace_fn_impl,
		"list_traces_fn": in_memory_list_traces_fn_impl,
		"metadata": metadata
	})
}

func reset_in_memory_trace_sink_impl(options) {
	options_map := normalize_dict(options)
	store_id := normalize_string(dict_get_or(options_map, "store_id", "in-memory-trace-sink"), "in-memory-trace-sink")
	IN_MEMORY_TRACE_SINKS[store_id] := default_in_memory_trace_state()

	return {
		"ok": true,
		"store_id": store_id
	}
}

func jsonl_append_trace_fn_impl(sink_input, trace_input, options) {
	sink := normalize_dict(sink_input)
	resolved_path := resolve_jsonl_trace_file_path(sink)
	if dict_get_or(resolved_path, "ok", false) == false {
		return {
			"ok": false,
			"error": dict_get_or(resolved_path, "error", {
				"kind": "invalid_path",
				"message": "JSONL trace sink path is invalid."
			})
		}
	}

	trace := to_trace_record(trace_input)
	file_path := normalize_string(dict_get_or(resolved_path, "file_path", ""), "")
	line_text := to_json(trace) + "\n"

	try {
		if file_exists(file_path) {
			append_file(file_path, line_text)
		} else {
			write_file(file_path, line_text)
		}
	} except err {
		return {
			"ok": false,
			"error": {
				"kind": "trace_sink_write_failed",
				"message": "Failed to append trace record to JSONL sink.",
				"details": {
					"file_path": file_path,
					"error": to_string(err)
				}
			}
		}
	}

	return {
		"ok": true,
		"trace": trace,
		"file_path": file_path
	}
}

func jsonl_list_traces_fn_impl(sink_input, options_input) {
	sink := normalize_dict(sink_input)
	resolved_path := resolve_jsonl_trace_file_path(sink)
	if dict_get_or(resolved_path, "ok", false) == false {
		return {
			"ok": false,
			"error": dict_get_or(resolved_path, "error", {
				"kind": "invalid_path",
				"message": "JSONL trace sink path is invalid."
			})
		}
	}

	file_path := normalize_string(dict_get_or(resolved_path, "file_path", ""), "")
	filter_map := normalize_dict(options_input)

	if file_exists(file_path) == false {
		return {
			"ok": true,
			"traces": [],
			"count": 0,
			"total_count": 0,
			"file_path": file_path
		}
	}

	raw_text := ""
	try {
		raw_text = to_string(read_file(file_path))
	} except err {
		return {
			"ok": false,
			"error": {
				"kind": "trace_sink_read_failed",
				"message": "Failed to read trace records from JSONL sink.",
				"details": {
					"file_path": file_path,
					"error": to_string(err)
				}
			}
		}
	}

	lines := split(raw_text, "\n")
	filtered := []
	index := 0
	total_lines := len(lines)
	while index < total_lines {
		line_text := normalize_string(lines[index], "")
		if line_text != "" {
			parsed := {}
			parsed_ok := true
			try {
				parsed = normalize_dict(parse_json(line_text))
			} except err {
				parsed_ok = false
			}

			if parsed_ok {
				trace := to_trace_record(parsed)
				if matches_trace_filter(trace, filter_map) {
					filtered = push(filtered, trace)
				}
			}
		}
		index = index + 1
	}

	offset := normalize_non_negative_int(dict_get_or(filter_map, "offset", 0), 0)
	limit := normalize_non_negative_int(dict_get_or(filter_map, "limit", len(filtered)), len(filtered))
	if limit <= 0 {
		limit = len(filtered)
	}

	items := []
	cursor := offset
	max_items := offset + limit
	if max_items > len(filtered) {
		max_items = len(filtered)
	}

	while cursor < max_items {
		items = push(items, filtered[cursor])
		cursor = cursor + 1
	}

	return {
		"ok": true,
		"traces": items,
		"count": len(filtered),
		"total_count": len(filtered),
		"file_path": file_path
	}
}

func create_jsonl_trace_sink_impl(options) {
	options_map := normalize_dict(options)
	root_path := normalize_string(dict_get_or(options_map, "root_path", "/tmp"), "/tmp")
	file_name := normalize_string(dict_get_or(options_map, "file_name", "agent-trace.jsonl"), "agent-trace.jsonl")

	metadata := clone_value(dict_get_or(options_map, "metadata", {}))
	metadata["store_kind"] := "jsonl"
	metadata["root_path"] := root_path
	metadata["file_name"] := file_name

	return create_trace_sink_interface_impl({
		"name": normalize_string(dict_get_or(options_map, "name", "JsonlTraceSink"), "JsonlTraceSink"),
		"append_trace_fn": jsonl_append_trace_fn_impl,
		"list_traces_fn": jsonl_list_traces_fn_impl,
		"metadata": metadata
	})
}

func ensure_trace_sink_impl(sink_input) {
	sink := normalize_dict(sink_input)
	if normalize_string(dict_get_or(sink, "type", ""), "") == "TraceSink" {
		return sink
	}

	return create_trace_sink_interface_impl({})
}

func not_implemented_result(operation_name) {
	return {
		"ok": false,
		"error": {
			"kind": "not_implemented",
			"message": "Trace sink operation is not implemented.",
			"details": {
				"operation": normalize_string(operation_name, "unknown")
			}
		}
	}
}

func trace_sink_append_impl(sink_input, event_input, options) {
	sink := ensure_trace_sink_impl(sink_input)
	append_fn := dict_get_or(sink, "append_trace_fn", null)
	if type(append_fn) != "function" {
		return not_implemented_result("append_trace")
	}

	event := create_trace_event_impl(dict_get_or(event_input, "event_kind", "run_failed"), dict_get_or(event_input, "payload", {}), {
		"trace_id": dict_get_or(event_input, "trace_id", ""),
		"run_id": dict_get_or(event_input, "run_id", ""),
		"agent_id": dict_get_or(event_input, "agent_id", ""),
		"session_id": dict_get_or(event_input, "session_id", ""),
		"step_id": dict_get_or(event_input, "step_id", ""),
		"timestamp": dict_get_or(event_input, "timestamp", ""),
		"sequence": dict_get_or(event_input, "sequence", 0),
		"metadata": dict_get_or(event_input, "metadata", {}),
		"runtime_services": dict_get_or(options, "runtime_services", dict_get_or(event_input, "runtime_services", create_runtime_services({})))
	})

	redaction_result := apply_trace_redaction_policy(event, options)
	event = to_trace_record(dict_get_or(redaction_result, "trace", event))

	validation := validate_trace_event_shape_impl(event)
	if dict_get_or(validation, "ok", false) == false {
		return {
			"ok": false,
			"error": {
				"kind": "trace_event_invalid",
				"message": "Trace event payload is invalid.",
				"details": {
					"violations": dict_get_or(validation, "errors", [])
				}
			}
		}
	}

	return append_fn(sink, event, normalize_dict(options))
}

func trace_sink_list_impl(sink_input, options) {
	sink := ensure_trace_sink_impl(sink_input)
	list_fn := dict_get_or(sink, "list_traces_fn", null)
	if type(list_fn) != "function" {
		return not_implemented_result("list_traces")
	}

	return list_fn(sink, normalize_dict(options))
}

func describe_trace_sink_module_impl() {
	return {
		"module": "agents.tracing.sink",
		"status": "active",
		"contract_version": "0.1.0",
		"exports": [
			"trace_required_fields",
			"create_trace_event",
			"validate_trace_event_shape",
			"create_trace_sink_interface",
			"create_in_memory_trace_sink",
			"create_jsonl_trace_sink",
			"reset_in_memory_trace_sink",
			"trace_sink_append",
			"trace_sink_list"
		]
	}
}

