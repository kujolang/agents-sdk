# Metadata-only Watchdog v2 adapter for Agents SDK lifecycle events.
# Delivery, credentials, retries, and retention remain host responsibilities.

func wd_get(value, key, fallback_value) {
	if type(value) == "dict" && has_key(value, key) { return value[key] }
	return fallback_value
}

func wd_text(value, max_len) {
	if type(value) == "null" { return "" }
	text := trim(to_string(value))
	if len(text) <= max_len { return text }
	return substring(text, 0, max_len)
}

func wd_timestamp(value) {
	text := wd_text(value, 80)
	if text == "" { return "1970-01-01T00:00:00Z" }
	if contains(text, "T") == 0 { text = replace(text, " ", "T") }
	if ends_with(text, "Z") == false && contains(substring(text, 10, len(text)), "+") == 0 { text = text + "Z" }
	return text
}

func wd_id(value, length) {
	text := to_lower(wd_text(value, 512))
	if len(text) == length {
		valid := true
		all_zero := true
		i := 0
		while i < len(text) {
			if contains("0123456789abcdef", substring(text, i, i + 1)) == 0 { valid = false }
			if substring(text, i, i + 1) != "0" { all_zero = false }
			i = i + 1
		}
		if valid && all_zero == false { return text }
	}
	return substring(sha256("agents-sdk:" + wd_text(value, 512)), 0, length)
}

func wd_event_kind(event) { return wd_text(wd_get(event, "event_kind", wd_get(event, "kind", "unknown")), 80) }

func wd_ends_with_any(value, suffixes) {
	for suffix in suffixes { if ends_with(value, suffix) { return true } }
	return false
}

func wd_operation_kind(event_kind) {
	if starts_with(event_kind, "run_") { return "agent" }
	if starts_with(event_kind, "model_request_") { return "model" }
	if starts_with(event_kind, "tool_call_") { return "tool" }
	if starts_with(event_kind, "handoff_") { return "handoff" }
	if starts_with(event_kind, "memory_") { return "persistence" }
	if starts_with(event_kind, "guardrail_") || starts_with(event_kind, "budget_") { return "approval" }
	if event_kind == "artifact_created" { return "persistence" }
	return "internal"
}

func wd_is_timed_operation(event_kind) {
	return starts_with(event_kind, "run_") || starts_with(event_kind, "model_request_") || starts_with(event_kind, "tool_call_started") || starts_with(event_kind, "tool_call_completed") || starts_with(event_kind, "tool_call_failed") || starts_with(event_kind, "handoff_")
}

func wd_status(event_kind) {
	if wd_ends_with_any(event_kind, ["_completed", "_approved", "_passed"]) { return "ok" }
	if wd_ends_with_any(event_kind, ["_failed", "_exceeded"]) { return "error" }
	if wd_ends_with_any(event_kind, ["_cancelled"]) { return "cancelled" }
	if wd_ends_with_any(event_kind, ["_denied", "_blocked"]) { return "denied" }
	return "unset"
}

func wd_operation_key(event, event_kind) {
	payload := wd_get(event, "payload", {})
	run_id := wd_text(wd_get(event, "run_id", ""), 160)
	step_id := wd_text(wd_get(event, "step_id", wd_get(payload, "step_id", "")), 160)
	if starts_with(event_kind, "run_") { return "run:" + run_id }
	if starts_with(event_kind, "model_request_") { return "model:" + run_id + ":" + step_id }
	if starts_with(event_kind, "tool_call_") {
		tool_call_id := wd_text(wd_get(payload, "tool_call_id", step_id), 160)
		return "tool:" + run_id + ":" + tool_call_id
	}
	if starts_with(event_kind, "handoff_") {
		request_id := wd_text(wd_get(payload, "request_id", step_id), 160)
		return "handoff:" + run_id + ":" + request_id
	}
	return "event:" + wd_text(wd_get(event, "event_id", event_kind + ":" + to_string(wd_get(event, "sequence", 0))), 160)
}

func wd_reference(ref_type, ref_id) {
	return {"type": ref_type, "id": wd_text(ref_id, 160), "namespace": "kujo-agents-sdk", "relation": "groups"}
}

func wd_references(event) {
	references := []
	payload := wd_get(event, "payload", {})
	session_id := wd_text(wd_get(event, "session_id", ""), 160)
	run_id := wd_text(wd_get(event, "run_id", ""), 160)
	agent_id := wd_text(wd_get(event, "agent_id", ""), 160)
	step_id := wd_text(wd_get(event, "step_id", ""), 160)
	if session_id != "" { references = push(references, wd_reference("session", session_id)) }
	if run_id != "" { references = push(references, wd_reference("run", run_id)) }
	if agent_id != "" { references = push(references, wd_reference("agent", agent_id)) }
	if step_id != "" { references = push(references, wd_reference("task", step_id)) }
	ref_fields := {"tool_call": "tool_call_id", "artifact": "artifact_id", "evaluation": "evaluation_id", "workflow": "workflow_id", "request": "request_id"}
	if type(payload) == "dict" {
		for ref_type in keys(ref_fields) {
			ref_id := wd_text(wd_get(payload, ref_fields[ref_type], ""), 160)
			if ref_id != "" { references = push(references, wd_reference(ref_type, ref_id)) }
		}
		target_agent_id := wd_text(wd_get(payload, "target_agent_id", ""), 160)
		if target_agent_id != "" { references = push(references, {"type": "agent", "id": target_agent_id, "namespace": "kujo-agents-sdk", "relation": "handoff_target"}) }
	}
	return references
}

func wd_scalar_attributes(event) {
	attributes := {"agents_sdk.event_kind": wd_event_kind(event), "agents_sdk.sequence": wd_get(event, "sequence", 0)}
	payload := wd_get(event, "payload", {})
	allowlist := ["model", "provider", "tool_name", "tool_call_id", "status", "reason", "attempt", "model_attempts", "model_retries_used", "handoff_target", "source_agent_id", "target_agent_id", "target_status", "request_id", "depth", "max_depth", "artifact_id", "artifact_kind", "artifact_bytes", "stage", "error_kind", "failure_kind", "messages_count", "stop_reason"]
	if type(payload) == "dict" {
		for key in allowlist {
			if has_key(payload, key) {
				value := payload[key]
				if type(value) == "string" || type(value) == "int" || type(value) == "float" || type(value) == "bool" || type(value) == "null" { attributes["agents_sdk." + key] = value }
			}
		}
	}
	return attributes
}

func wd_usage(event) {
	payload := wd_get(event, "payload", {})
	usage := wd_get(payload, "usage", {})
	if type(usage) != "dict" { return null }
	input_tokens := wd_get(usage, "input_tokens", wd_get(usage, "prompt_tokens", null))
	output_tokens := wd_get(usage, "output_tokens", wd_get(usage, "completion_tokens", null))
	total_tokens := wd_get(usage, "total_tokens", null)
	if type(input_tokens) == "null" && type(output_tokens) == "null" && type(total_tokens) == "null" { return null }
	return {
		"input_tokens": input_tokens,
		"output_tokens": output_tokens,
		"total_tokens": total_tokens,
		"cached_input_tokens": wd_get(usage, "cached_input_tokens", wd_get(usage, "cache_read_input_tokens", null)),
		"cache_write_input_tokens": wd_get(usage, "cache_write_input_tokens", null),
		"reasoning_tokens": wd_get(usage, "reasoning_tokens", null),
		"usage_source": wd_text(wd_get(usage, "usage_source", "agents-sdk"), 80),
		"total_semantics": wd_text(wd_get(usage, "total_semantics", "source_preserved"), 120),
		"provider_usage": wd_get(usage, "provider_usage", usage)
	}
}

func wd_costs(event) {
	payload := wd_get(event, "payload", {})
	usage := wd_get(payload, "usage", {})
	if type(usage) != "dict" { return [] }
	amount := wd_get(usage, "provider_reported_cost", wd_get(usage, "cost", null))
	if type(amount) == "null" { return [] }
	return [{"kind": "provider_reported", "currency": wd_text(wd_get(usage, "currency", "USD"), 3), "amount": amount, "source": wd_text(wd_get(usage, "cost_source", "agents-sdk-provider-response"), 120), "catalog_version": null, "calculated_at": null, "components": null}]
}

func wd_error(event, status) {
	if status != "error" && status != "timeout" && status != "denied" { return null }
	payload := wd_get(event, "payload", {})
	error_kind := wd_text(wd_get(payload, "error_kind", wd_get(payload, "failure_kind", status)), 120)
	return {"class": error_kind, "category": wd_operation_kind(wd_event_kind(event)), "code": error_kind, "retryable": null, "message": null}
}

func watchdog_record_impl(event) {
	if type(event) != "dict" { return {"ok": false, "error": "event must be an object", "record": null} }
	trace_source := wd_text(wd_get(event, "trace_id", wd_get(event, "run_id", "")), 160)
	if trace_source == "" { return {"ok": false, "error": "trace_id or run_id is required", "record": null} }
	event_kind := wd_event_kind(event)
	event_id := wd_text(wd_get(event, "event_id", trace_source + ":" + event_kind + ":" + to_string(wd_get(event, "sequence", 0))), 160)
	operation_key := wd_operation_key(event, event_kind)
	is_timed := wd_is_timed_operation(event_kind)
	record_type := "event"
	span_id := null
	parent_span_id := null
	record_id := "agents-sdk:event:" + event_id
	if is_timed {
		record_type = "span"
		span_id = wd_id(operation_key, 16)
		record_id = "agents-sdk:span:" + wd_text(operation_key, 140)
		if starts_with(event_kind, "run_") == false {
			run_id := wd_text(wd_get(event, "run_id", ""), 160)
			if run_id != "" { parent_span_id = wd_id("run:" + run_id, 16) }
		}
	}
	status := wd_status(event_kind)
	observed_at := wd_timestamp(wd_get(event, "timestamp", ""))
	started_at := null
	ended_at := null
	if is_timed && (ends_with(event_kind, "_started") || ends_with(event_kind, "_requested")) { started_at = observed_at }
	if is_timed && status != "unset" { ended_at = observed_at }
	record := {
		"record_id": record_id,
		"record_type": record_type,
		"trace_id": wd_id(trace_source, 32),
		"span_id": span_id,
		"parent_span_id": parent_span_id,
		"observed_at": observed_at,
		"started_at": started_at,
		"ended_at": ended_at,
		"kind": wd_operation_kind(event_kind),
		"name": "agents-sdk." + event_kind,
		"status": status,
		"source": {"producer": "kujo-agents-sdk", "adapter_id": "kujo-agents-sdk.native", "adapter_version": "watchdog.ingestion-adapter.v1", "original_schema": "agents-sdk.AgentEvent", "source_event_id": event_id},
		"references": wd_references(event),
		"attributes": wd_scalar_attributes(event),
		"usage": wd_usage(event),
		"costs": wd_costs(event),
		"error": wd_error(event, status),
		"content": [],
		"privacy": {"content_mode": "off", "policy_version": "watchdog.privacy.v1", "transformations": []}
	}
	return {"ok": true, "error": "", "record": record}
}

func watchdog_batch_impl(events, batch_id, producer_version) {
	if type(events) != "array" || len(events) == 0 || len(events) > 100 { return {"ok": false, "error": "events must contain 1-100 items", "batch": null} }
	if wd_text(batch_id, 160) == "" { return {"ok": false, "error": "batch_id is required", "batch": null} }
	records := []
	for event in events {
		mapped := watchdog_record_impl(event)
		if mapped["ok"] == false { return {"ok": false, "error": mapped["error"], "batch": null} }
		records = push(records, mapped["record"])
	}
	return {"ok": true, "error": "", "batch": {
		"schema_version": "watchdog.telemetry.v2",
		"batch_id": wd_text(batch_id, 160),
		"sent_at": records[len(records) - 1]["observed_at"],
		"producer": {"name": "kujo-agents-sdk", "version": wd_text(producer_version, 40), "adapter_id": "kujo-agents-sdk.native", "adapter_version": "watchdog.ingestion-adapter.v1", "original_schema": "agents-sdk.TraceEvent"},
		"records": records
	}}
}

func watchdog_batches_from_run_result_impl(run_result, batch_id, producer_version) {
	if type(run_result) != "dict" { return {"ok": false, "error": "run_result must be an object", "batches": []} }
	metadata := wd_get(run_result, "metadata", {})
	events := wd_get(metadata, "events", wd_get(run_result, "events", []))
	if type(events) != "array" || len(events) == 0 { return {"ok": false, "error": "run_result contains no lifecycle events", "batches": []} }
	batches := []
	chunk := []
	chunk_index := 1
	for event in events {
		chunk = push(chunk, event)
		if len(chunk) == 100 {
			mapped := watchdog_batch_impl(chunk, wd_text(batch_id, 150) + ":" + to_string(chunk_index), producer_version)
			if mapped["ok"] == false { return {"ok": false, "error": mapped["error"], "batches": []} }
			batches = push(batches, mapped["batch"])
			chunk = []
			chunk_index = chunk_index + 1
		}
	}
	if len(chunk) > 0 {
		mapped := watchdog_batch_impl(chunk, wd_text(batch_id, 150) + ":" + to_string(chunk_index), producer_version)
		if mapped["ok"] == false { return {"ok": false, "error": mapped["error"], "batches": []} }
		batches = push(batches, mapped["batch"])
	}
	return {"ok": true, "error": "", "batches": batches, "events_count": len(events), "records_count": len(events)}
}

func watchdog_trace_context_impl(trace_source, operation_source) {
	trace_id := wd_id(trace_source, 32)
	span_id := wd_id(operation_source, 16)
	return {"trace_id": trace_id, "span_id": span_id, "traceparent": "00-" + trace_id + "-" + span_id + "-01", "tracestate": "", "baggage": ""}
}

func watchdog_deliver_batches_impl(client, batches) {
	if type(client) != "dict" { return {"ok": true, "delivered": 0, "queued": 0, "failed": 0, "fail_open": true, "warnings": ["Watchdog client is not configured."]} }
	send_batch_fn := wd_get(client, "send_batch_fn", null)
	queue_batch_fn := wd_get(client, "queue_batch_fn", null)
	if type(batches) != "array" { return {"ok": true, "delivered": 0, "queued": 0, "failed": 0, "fail_open": true, "warnings": ["Watchdog batches are invalid."]} }
	delivered := 0
	queued := 0
	failed := 0
	warnings := []
	for batch in batches {
		result := {"ok": false}
		if type(send_batch_fn) == "function" {
			try { result = send_batch_fn(client, batch) } except err { result = {"ok": false, "error": to_string(err)} }
		}
		if type(result) == "dict" && wd_get(result, "ok", false) { delivered = delivered + 1 } else {
			queued_result := {"ok": false}
			if type(queue_batch_fn) == "function" {
				try { queued_result = queue_batch_fn(client, batch) } except err { queued_result = {"ok": false, "error": to_string(err)} }
			}
			if type(queued_result) == "dict" && wd_get(queued_result, "ok", false) { queued = queued + 1 } else {
				failed = failed + 1
				warnings = push(warnings, "Watchdog delivery failed open for batch " + wd_text(wd_get(batch, "batch_id", "unknown"), 160) + ".")
			}
		}
	}
	return {"ok": true, "delivered": delivered, "queued": queued, "failed": failed, "fail_open": true, "warnings": warnings}
}

export watchdog_telemetry_record := watchdog_record_impl
export watchdog_telemetry_batch := watchdog_batch_impl
export watchdog_telemetry_batches_from_run_result := watchdog_batches_from_run_result_impl
export watchdog_trace_context := watchdog_trace_context_impl
export watchdog_deliver_batches := watchdog_deliver_batches_impl
