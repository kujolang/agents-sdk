from src.agents.ai.adapter import create_ai_sdk_adapter
from src.agents.runner import create_agent_runner, run_agent
from src.agents.core_types import create_agent, create_agent_run_request
from examples.support import offline_example_success, offline_model_response

func run_handoff_agent_example_impl() {
	fake_chat := func(client, messages, request_options) {
		first_content := ""
		if len(messages) > 0 {
			first_message := messages[0]
			if type(first_message) == "dict" {
				first_content = to_string(first_message["content"])
			}
		}

		if first_content == "Writer target instructions." {
			return offline_model_response("handoff-writer-output", {})
		}

		return offline_model_response("handoff-planner-output", {})
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})

	planner_agent := create_agent({
		"id": "example-planner-agent",
		"name": "Example Planner Agent",
		"instructions": "Planner source instructions.",
		"policy": {
			"handoff": {
				"target_agent_id": "example-writer-agent",
				"reason": "Writer should finalize tone.",
				"request_id": "example-handoff-request"
			}
		}
	})
	writer_agent := create_agent({
		"id": "example-writer-agent",
		"name": "Example Writer Agent",
		"instructions": "Writer target instructions."
	})

	runner := create_agent_runner({
		"ai_adapter": adapter,
		"handoff_registry": {
			"example-writer-agent": writer_agent
		}
	})
	run_request := create_agent_run_request("Plan then hand off", {
		"run_id": "run-example-handoff",
		"session_id": "session-example-handoff"
	})

	result := run_agent(runner, planner_agent, run_request, {})

	return offline_example_success("handoff_agent", result, {})
}

export run_handoff_agent_example := run_handoff_agent_example_impl
