from src.agents.testing.no_network import create_no_network_harness
from src.agents.runner import create_agent_runner, run_agent
from src.agents.core_types import create_agent, create_agent_run_request
from src.agents.tracing.sink import create_in_memory_trace_sink, create_trace_event
from src.agents.tracing.sink import trace_sink_append, trace_sink_list
from examples.support import offline_example_error

func run_traced_agent_example_impl() {
	harness_result := create_no_network_harness({
		"model": {
			"output_text": "traced-agent-offline"
		}
	})
	if harness_result["ok"] == false {
		return offline_example_error(harness_result["error"])
	}

	harness := harness_result
	runner := create_agent_runner({
		"ai_adapter": harness["model_adapter"]
	})
	agent := create_agent({
		"id": "example-traced-agent",
		"name": "Example Traced Agent"
	})
	run_request := create_agent_run_request("Produce traced output", {
		"run_id": "run-example-traced",
		"session_id": "session-example-traced"
	})

	result := run_agent(runner, agent, run_request, {})
	trace_sink := create_in_memory_trace_sink({
		"store_id": "example-trace-store"
	})
	trace_event := create_trace_event("run_completed", {
		"result_status": result["status"]
	}, {
		"run_id": "run-example-traced",
		"agent_id": "example-traced-agent",
		"session_id": "session-example-traced",
		"step_id": "",
		"sequence": 1
	})
	append_result := trace_sink_append(trace_sink, trace_event, {})
	list_result := trace_sink_list(trace_sink, {})

	return {
		"ok": true,
		"requires_network": false,
		"scenario": "traced_agent",
		"result": result,
		"trace_append": append_result,
		"trace_list": list_result
	}
}

export run_traced_agent_example := run_traced_agent_example_impl
