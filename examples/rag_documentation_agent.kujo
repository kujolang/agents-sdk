# Opt-in live local RAG example. Start the documented RAG pilot first.
# The model callback is offline; captured messages show actual model input.
from src.agents.retrieval.rag_adapter import create_kujo_rag_provider, create_kujo_rag_http_transport
from src.agents.core_types import create_agent, create_agent_run_request
from src.agents.runner import create_agent_runner, run_agent
from src.agents.ai.adapter import create_ai_sdk_adapter

transport := create_kujo_rag_http_transport(env_or("RAG_URL", "http://127.0.0.1:8787"), {"bearer_token": env_or("RAG_TOKEN", "")})
provider := create_kujo_rag_provider({
 "supports_preferences": true,
 "namespace": env_or("RAG_NAMESPACE", "default"),
 "transport": func(request, options) {
  print(to_json({"retrieval_request": true}))
  return transport(request, options)
 }
})
metadata := {}
language := env_or("RAG_EXAMPLE_LANGUAGE", "")
if language != "" { metadata["retrieval_preferences"] := {"programming_language": language} }
target := create_agent({"id": "docs", "instructions": "Documentation target", "metadata": {"retrieval_preferences": {"programming_language": "javascript"}}, "policy": {"retrieval": {"enabled": true}}})
pilot_handoffs := {}
if env_or("RAG_EXAMPLE_HANDOFF", "0") == "1" { pilot_handoffs = {"docs": target} }
runner := create_agent_runner({"handoff_registry": pilot_handoffs, "ai_adapter": create_ai_sdk_adapter({"chat_completion_fn": func(client, messages, options) {
 print(to_json({"model_input": messages}))
 return {"ok": true, "status_code": 200, "output_text": "Documentation retrieved."}
}})})
source := create_agent({"policy": {"retrieval": {"enabled": true}}})
if env_or("RAG_EXAMPLE_HANDOFF", "0") == "1" {
 source = create_agent({"instructions": "Handoff source", "policy": {"retrieval": {"enabled": false}, "target_agent_id": "docs", "handoff": {"target_agent_id": "docs"}}})
}
result := run_agent(runner, source, create_agent_run_request("How do I query the RAG API?", {"metadata": metadata}), {"retrieval_provider": provider})
print(to_json({"status": result["status"], "retrieval": result["metadata"]["retrieval"]}))
if result["metadata"]["retrieval"]["reason"] != "applied" { exit(1) }
