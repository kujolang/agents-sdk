from examples.hello_agent import run_hello_agent_example
from examples.tool_agent import run_tool_agent_example
from examples.approval_agent import run_approval_agent_example
from examples.retrieval_agent import run_retrieval_agent_example
from examples.handoff_agent import run_handoff_agent_example
from examples.traced_agent import run_traced_agent_example
from examples.artifact_agent import run_artifact_agent_example

func summarize_example_result(raw_result) {
	result := raw_result
	if type(raw_result) != "dict" {
		return {
			"ok": false,
			"status": "invalid",
			"requires_network": false
		}
	}

	run_result := {}
	if has_key(result, "result") {
		candidate := result["result"]
		if type(candidate) == "dict" {
			run_result = candidate
		}
	}

	status := "unknown"
	if has_key(run_result, "status") {
		status = to_string(run_result["status"])
	}

	requires_network := false
	if has_key(result, "requires_network") {
		requires_network = result["requires_network"]
	}

	return {
		"ok": result["ok"],
		"status": status,
		"requires_network": requires_network
	}
}

func run_all_examples_impl() {
	examples := [
		{"name": "hello_agent", "result": run_hello_agent_example()},
		{"name": "tool_agent", "result": run_tool_agent_example()},
		{"name": "approval_agent", "result": run_approval_agent_example()},
		{"name": "retrieval_agent", "result": run_retrieval_agent_example()},
		{"name": "handoff_agent", "result": run_handoff_agent_example()},
		{"name": "traced_agent", "result": run_traced_agent_example()},
		{"name": "artifact_agent", "result": run_artifact_agent_example()}
	]

	results := {}
	for example in examples {
		results[example["name"]] := summarize_example_result(example["result"])
	}

	return results
}

func main() {
	results := run_all_examples_impl()
	print(to_json(results))
}

export run_all_examples := run_all_examples_impl
main()
