from src.agents.testing.no_network import create_no_network_harness
from src.agents.runner import create_agent_runner, run_agent
from src.agents.core_types import create_agent, create_agent_run_request

func run_hello_agent_example_impl() {
	harness_result := create_no_network_harness({
		"model": {
			"output_text": "hello-agent-offline"
		}
	})
	if harness_result["ok"] == false {
		return {
			"ok": false,
			"requires_network": false,
			"error": harness_result["error"]
		}
	}

	harness := harness_result
	runner := create_agent_runner({
		"ai_adapter": harness["model_adapter"]
	})
	agent := create_agent({
		"id": "example-hello-agent",
		"name": "Example Hello Agent",
		"instructions": "Reply concisely."
	})
	run_request := create_agent_run_request("Say hello", {
		"run_id": "run-example-hello",
		"session_id": "session-example-hello"
	})

	result := run_agent(runner, agent, run_request, {
		"tool_registry": harness["tool_registry"]
	})

	return {
		"ok": true,
		"requires_network": false,
		"scenario": "hello_agent",
		"result": result
	}
}

export run_hello_agent_example := run_hello_agent_example_impl
