test_setup {
	from src.agents.tracing.watchdog import watchdog_telemetry_record, watchdog_telemetry_batch, watchdog_telemetry_batches_from_run_result, watchdog_trace_context, watchdog_deliver_batches
}

test "Watchdog adapter emits metadata-only canonical records" {
	event := {
		"trace_id": "trace-source-1", "run_id": "run-1", "session_id": "session-1", "agent_id": "agent-1", "step_id": "step-1",
		"event_kind": "tool_call_completed", "timestamp": "2026-09-01 12:00:00", "sequence": 4,
		"payload": {"tool_name": "search", "status": "ok", "tool_input": "must-not-leak", "tool_output": "must-not-leak"}
	}
	result := watchdog_telemetry_record(event)
	assert_equal(result["ok"], true)
	record := result["record"]
	assert_equal(record["record_type"], "span")
	assert_equal(record["kind"], "tool")
	assert_equal(record["status"], "ok")
	assert_equal(len(record["trace_id"]), 32)
	assert_equal(record["observed_at"], "2026-09-01T12:00:00Z")
	assert_equal(record["attributes"]["agents_sdk.tool_name"], "search")
	assert_equal(has_key(record["attributes"], "agents_sdk.tool_input"), 0)
	assert_equal(record["privacy"]["content_mode"], "off")
	assert_equal(len(record["content"]), 0)
}

test "Watchdog adapter correlates lifecycle pairs as one canonical span" {
	started := watchdog_telemetry_record({"trace_id": "0123456789abcdef0123456789abcdef", "run_id": "run-1", "session_id": "session-1", "agent_id": "agent-1", "step_id": "model-1", "kind": "model_request_started", "event_id": "event-start", "timestamp": "2026-09-01T12:00:00Z", "payload": {"messages_count": 2}})
	completed := watchdog_telemetry_record({"trace_id": "0123456789abcdef0123456789abcdef", "run_id": "run-1", "session_id": "session-1", "agent_id": "agent-1", "step_id": "model-1", "kind": "model_request_completed", "event_id": "event-end", "timestamp": "2026-09-01T12:00:01Z", "payload": {"model_attempts": 1, "usage": {"input_tokens": 12, "output_tokens": 3, "total_tokens": 15, "cached_input_tokens": 2}}})
	assert_equal(started["ok"], true)
	assert_equal(completed["ok"], true)
	assert_equal(started["record"]["record_id"], completed["record"]["record_id"])
	assert_equal(started["record"]["span_id"], completed["record"]["span_id"])
	assert_equal(started["record"]["trace_id"], "0123456789abcdef0123456789abcdef")
	assert_equal(started["record"]["started_at"], "2026-09-01T12:00:00Z")
	assert_equal(completed["record"]["ended_at"], "2026-09-01T12:00:01Z")
	assert_equal(completed["record"]["status"], "ok")
	assert_equal(completed["record"]["usage"]["cached_input_tokens"], 2)
	assert_equal(completed["record"]["parent_span_id"], watchdog_trace_context("0123456789abcdef0123456789abcdef", "run:run-1")["span_id"])
}

test "Watchdog adapter creates a bounded v2 batch" {
	events := [{"trace_id": "trace-2", "run_id": "run-2", "event_kind": "run_started", "timestamp": "2026-09-01T12:00:00Z", "sequence": 1, "payload": {}}]
	result := watchdog_telemetry_batch(events, "batch-2", "0.1.0")
	assert_equal(result["ok"], true)
	assert_equal(result["batch"]["schema_version"], "watchdog.telemetry.v2")
	assert_equal(result["batch"]["producer"]["name"], "kujo-agents-sdk")
	assert_equal(len(result["batch"]["records"]), 1)
}

test "Watchdog adapter rejects uncorrelated and oversized input" {
	missing := watchdog_telemetry_record({"event_kind": "run_started"})
	assert_equal(missing["ok"], false)
	too_many := []
	index := 0
	while index < 101 { too_many = push(too_many, {"run_id": "run", "event_kind": "run_started"}); index = index + 1 }
	bounded := watchdog_telemetry_batch(too_many, "batch", "0.1.0")
	assert_equal(bounded["ok"], false)
}

test "Watchdog adapter chunks run results and delivery fails open" {
	events := []
	index := 0
	while index < 101 {
		events = push(events, {"run_id": "run-chunk", "session_id": "session-chunk", "agent_id": "agent-chunk", "kind": "budget_updated", "event_id": "event-" + to_string(index), "timestamp": "2026-09-01T12:00:00Z", "payload": {"stage": "after_model"}})
		index = index + 1
	}
	mapped := watchdog_telemetry_batches_from_run_result({"metadata": {"events": events}}, "run-chunk-batch", "1.0.0")
	assert_equal(mapped["ok"], true)
	assert_equal(len(mapped["batches"]), 2)
	assert_equal(len(mapped["batches"][0]["records"]), 100)
	assert_equal(len(mapped["batches"][1]["records"]), 1)

	send_failure := func(client, batch) { return {"ok": false, "error": "offline"} }
	queue_success := func(client, batch) { return {"ok": true} }
	delivery := watchdog_deliver_batches({"send_batch_fn": send_failure, "queue_batch_fn": queue_success}, mapped["batches"])
	assert_equal(delivery["ok"], true)
	assert_equal(delivery["delivered"], 0)
	assert_equal(delivery["queued"], 2)
	assert_equal(delivery["failed"], 0)
	assert_equal(delivery["fail_open"], true)
}
