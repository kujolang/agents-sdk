test_setup {
	from src.agents.streaming.events import stream_event_kind_values, stream_required_fields
	from src.agents.streaming.events import create_agent_stream_event, validate_stream_event_shape, map_ai_sdk_stream_event
	from src.agents.runtime.clock_ids import create_fixed_runtime_services
}

test "stream event contracts expose required kinds and fields" {
	kinds := stream_event_kind_values()
	kind_map := {}
	for kind in kinds {
		kind_map[kind] := true
	}

	fields := stream_required_fields()
	field_map := {}
	for field_name in fields {
		field_map[field_name] := true
	}

	assert_equal(has_key(kind_map, "model_delta"), 1)
	assert_equal(has_key(kind_map, "run_terminal"), 1)
	assert_equal(has_key(kind_map, "handoff_started"), 1)
	assert_equal(has_key(field_map, "kind"), 1)
	assert_equal(has_key(field_map, "payload"), 1)
}

test "create and validate stream events" {
	runtime_services := create_fixed_runtime_services(0, "2026-05-27 00:00:00", 9)
	event_payload := create_agent_stream_event("model_delta", {
		"delta": "A"
	}, {
		"run_id": "run-stream-1",
		"agent_id": "agent-stream-1",
		"session_id": "session-stream-1",
		"sequence": 1,
		"runtime_services": runtime_services
	})

	assert_equal(event_payload["type"], "AgentStreamEvent")
	assert_equal(event_payload["event_id"], "sev-9")
	assert_equal(event_payload["kind"], "model_delta")
	assert_equal(event_payload["timestamp"], "2026-05-27 00:00:00")

	validation := validate_stream_event_shape(event_payload)
	assert_equal(validation["ok"], true)
}

test "map_ai_sdk_stream_event normalizes delta and terminal events" {
	delta := map_ai_sdk_stream_event({
		"type": "delta",
		"delta": "Hello"
	}, {
		"run_id": "run-stream-map",
		"agent_id": "agent-stream-map",
		"session_id": "session-stream-map",
		"sequence": 1
	})
	assert_equal(delta["kind"], "model_delta")
	assert_equal(delta["payload"]["delta"], "Hello")

	terminal := map_ai_sdk_stream_event({
		"type": "done",
		"finish_reason": "stop"
	}, {
		"run_id": "run-stream-map",
		"agent_id": "agent-stream-map",
		"session_id": "session-stream-map",
		"sequence": 2
	})
	assert_equal(terminal["kind"], "run_terminal")
	assert_equal(terminal["payload"]["finish_reason"], "stop")
}
