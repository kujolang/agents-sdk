test_setup {
	from src.agents.core_types import default_agent_config, create_agent_config, validate_agent_config, create_agent, agent_execution_compatible
	from src.agents.core_types import create_agent_message, create_agent_step, create_agent_run_request, create_agent_context, create_agent_run_result
	from src.agents.core_types import agent_message_role_values, agent_step_kind_values, agent_run_status_values
}

test "routable agent metadata preserves handler and execution boundaries" {
	agent := create_agent({
		"id": "writer-a",
		"name": "Writer A",
		"handler_id": "writer-handler",
		"execution_contract": {"id": "report-writer", "version": "1"},
		"capabilities": {"write_report": true},
		"model_candidates": [{"provider": "openai", "model": "approved"}],
		"routing": {"enabled": true}
	})
	assert_equal(agent["handler_id"], "writer-handler")
	assert_equal(agent["execution_contract"]["id"], "report-writer")
	assert_equal(len(agent["model_candidates"]), 1)
	assert_true(agent["routing"]["enabled"])
}

test "execution compatibility requires same handler or versioned contract" {
	requested := create_agent({"id": "writer-a", "name": "A", "handler_id": "handler-a", "execution_contract": {"id": "writer", "version": "1"}})
	same_contract := create_agent({"id": "writer-b", "name": "B", "handler_id": "handler-b", "execution_contract": {"id": "writer", "version": "1"}})
	wrong_contract := create_agent({"id": "research", "name": "Research", "handler_id": "research", "execution_contract": {"id": "research", "version": "1"}})
	assert_true(agent_execution_compatible(requested, same_contract)["compatible"])
	assert_false(agent_execution_compatible(requested, wrong_contract)["compatible"])
	unversioned_a := create_agent({"id": "a", "name": "A", "handler_id": "a", "execution_contract": {"id": "writer"}})
	unversioned_b := create_agent({"id": "b", "name": "B", "handler_id": "b", "execution_contract": {"id": "writer"}})
	assert_false(agent_execution_compatible(unversioned_a, unversioned_b)["compatible"])
}

test "agent config validation requires versioned execution contracts" {
	validation := validate_agent_config({"id": "writer", "name": "Writer", "execution_contract": {"id": "writer"}})
	assert_false(validation["ok"])
	assert_equal(validation["errors"][0]["field"], "execution_contract")
}

test "default agent config exposes stable baseline fields" {
	defaults := default_agent_config()
	assert_equal(defaults["id"], "agent-default")
	assert_equal(defaults["name"], "Default Agent")
	assert_equal(defaults["max_iterations"], 8)
	assert_equal(defaults["timeout_ms"], 120000)
	assert_equal(type(defaults["tools"]), "array")
	assert_equal(type(defaults["metadata"]), "dict")
}

test "create_agent_config normalizes overrides and keeps defaults" {
	config := create_agent_config({
		"id": "writer",
		"name": "Writer Agent",
		"max_iterations": 14,
		"timeout_ms": 45000,
		"role": "assistant",
		"tools": [{"name": "search_docs"}],
		"metadata": {"team": "sdk"}
	})

	assert_equal(config["id"], "writer")
	assert_equal(config["name"], "Writer Agent")
	assert_equal(config["max_iterations"], 14)
	assert_equal(config["timeout_ms"], 45000)
	assert_equal(config["role"], "assistant")
	assert_equal(len(config["tools"]), 1)
	assert_equal(config["metadata"]["team"], "sdk")
}

test "validate_agent_config rejects missing required fields and invalid limits" {
	validation := validate_agent_config({
		"id": "",
		"name": "",
		"max_iterations": 0,
		"timeout_ms": -1,
		"role": "unknown"
	})

	assert_false(validation["ok"])
	assert_true(len(validation["errors"]) >= 4)
}

test "validate_agent_config rejects non-integer max_iterations" {
	validation := validate_agent_config({
		"id": "writer",
		"name": "Writer",
		"max_iterations": "8"
	})

	assert_false(validation["ok"])
	assert_equal(validation["errors"][0]["field"], "max_iterations")
}

test "validate_agent_config rejects non-integer timeout_ms" {
	validation := validate_agent_config({
		"id": "writer",
		"name": "Writer",
		"timeout_ms": "120000"
	})

	assert_false(validation["ok"])
	assert_equal(validation["errors"][0]["field"], "timeout_ms")
}

test "message step request context and result constructors produce stable contracts" {
	message := create_agent_message("assistant", "Hello", {"token_count": 2})
	step := create_agent_step("tool_call", "call search", {"tool": "search_docs"}, {})
	request := create_agent_run_request("Find release notes", {"run_id": "run-123", "session_id": "session-123", "stream": true})
	context := create_agent_context({"id": "writer", "name": "Writer Agent"}, request, {"mode": "test"})
	result := create_agent_run_result("completed", {"text": "done"}, {"steps": [step], "metadata": {"source": "test"}})

	assert_equal(message["type"], "AgentMessage")
	assert_equal(step["type"], "AgentStep")
	assert_equal(request["type"], "AgentRunRequest")
	assert_equal(context["type"], "AgentContext")
	assert_equal(result["type"], "AgentRunResult")
	assert_equal(result["status"], "completed")
}

test "core enum helpers provide expected values" {
	roles := agent_message_role_values()
	step_kinds := agent_step_kind_values()
	statuses := agent_run_status_values()

	assert_equal(roles[0], "system")
	assert_true(len(step_kinds) >= 5)
	assert_true(len(statuses) >= 5)
}
