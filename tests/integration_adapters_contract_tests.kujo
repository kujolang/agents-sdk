test_setup {
	from src.agents.integrations.adapters import mcp_2026_protocol_version
	from src.agents.integrations.adapters import create_mcp_2026_request_meta, create_mcp_2026_discover_request
	from src.agents.integrations.adapters import create_mcp_2026_list_tools_request, create_mcp_2026_call_tool_request
	from src.agents.integrations.adapters import normalize_mcp_2026_list_tools_result, normalize_mcp_2026_call_tool_result
	from src.agents.integrations.adapters import create_mcp_2026_unsupported_protocol_error, map_mcp_2026_tool_to_registry_entry
	from src.agents.integrations.adapters import create_external_tool_provider_adapter, external_provider_list_tools, external_provider_invoke_tool
	from src.agents.integrations.adapters import map_external_tool_to_registry_entry
	from src.agents.integrations.adapters import create_dispatch_integration_hooks, dispatch_run_agent_step, dispatch_invoke_workflow_as_tool
	from src.agents.integrations.adapters import create_watchdog_trace_adapter, watchdog_transform_trace_event
	from src.agents.integrations.adapters import create_scout_code_context_provider, scout_provider_resolve_context, map_scout_context_to_retrieval_enrichment
	from src.agents.integrations.adapters import convert_agent_to_dispatch, validate_dispatch_agent_conversion
}

test "Agents SDK configs convert to executable Dispatch model agents" {
	converted := convert_agent_to_dispatch({"id": "analyst", "name": "Analyst", "description": "Analyze inputs", "instructions": "Return a concise analysis.", "role": "assistant", "model_candidates": [{"provider": "openai", "model": "gpt-test"}], "tools": ["lookup"]}, {})
	assert_equal(converted["ok"], true)
	assert_equal(converted["agent"]["handler_id"], "model")
	assert_equal(converted["agent"]["execution_contract"]["id"], "analyst")
	assert_equal(converted["agent"]["metadata"]["source"], "kujo-agents-sdk")
	invalid := validate_dispatch_agent_conversion({"id": "", "name": "Missing"}, {})
	assert_equal(invalid["ok"], false)
	assert_true(len(invalid["errors"]) >= 2)
}

test "mcp 2026 request helpers build stateless metadata and headers" {
	meta := create_mcp_2026_request_meta({
		"client_info": {
			"name": "agents-test",
			"version": "1.2.3"
		},
		"extensions": {
			"io.modelcontextprotocol/tasks": {}
		},
		"trace_context": {
			"traceparent": "00-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-bbbbbbbbbbbbbbbb-01"
		}
	})
	assert_equal(mcp_2026_protocol_version(), "2026-07-28")
	assert_equal(meta["io.modelcontextprotocol/protocolVersion"], "2026-07-28")
	assert_equal(meta["io.modelcontextprotocol/clientInfo"]["name"], "agents-test")
	assert_equal(has_key(meta["io.modelcontextprotocol/clientCapabilities"]["extensions"], "io.modelcontextprotocol/tasks"), 1)
	assert_equal(meta["io.modelcontextprotocol/traceparent"], "00-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-bbbbbbbbbbbbbbbb-01")

	discover := create_mcp_2026_discover_request({
		"id": "discover-1",
		"client_info": {
			"name": "agents-test",
			"version": "1.2.3"
		}
	})
	assert_equal(discover["ok"], true)
	assert_equal(discover["request"]["method"], "server/discover")
	assert_equal(discover["headers"]["MCP-Protocol-Version"], "2026-07-28")
	assert_equal(discover["headers"]["Mcp-Method"], "server/discover")

	list_request := create_mcp_2026_list_tools_request({
		"id": "tools-1",
		"cursor": "cursor-1"
	})
	assert_equal(list_request["request"]["method"], "tools/list")
	assert_equal(list_request["request"]["params"]["cursor"], "cursor-1")
	assert_equal(list_request["request"]["params"]["_meta"]["io.modelcontextprotocol/protocolVersion"], "2026-07-28")

	call_request := create_mcp_2026_call_tool_request("search", {
		"query": "agents"
	}, {
		"id": "call-1",
		"input_responses": {
			"confirm": {
				"action": "accept"
			}
		},
		"request_state": "state-1"
	})
	assert_equal(call_request["request"]["method"], "tools/call")
	assert_equal(call_request["request"]["params"]["name"], "search")
	assert_equal(call_request["request"]["params"]["arguments"]["query"], "agents")
	assert_equal(call_request["request"]["params"]["inputResponses"]["confirm"]["action"], "accept")
	assert_equal(call_request["request"]["params"]["requestState"], "state-1")
	assert_equal(call_request["headers"]["Mcp-Name"], "search")
}

test "mcp 2026 tool mapping preserves schema dialect cache and display metadata" {
	response := {
		"jsonrpc": "2.0",
		"id": "tools-1",
		"result": {
			"resultType": "complete",
			"ttlMs": 300000,
			"cacheScope": "public",
			"nextCursor": "next-page",
			"tools": [
				{
					"name": "search",
					"title": "Search",
					"description": "Search external index",
					"inputSchema": {
						"$schema": "https://json-schema.org/draft/2020-12/schema",
						"type": "object",
						"properties": {
							"query": {
								"type": "string",
								"x-mcp-header": "Query"
							}
						},
						"required": ["query"]
					},
					"outputSchema": {
						"type": "object"
					},
					"icons": [
						{
							"src": "https://example.invalid/search.png",
							"mimeType": "image/png"
						}
					],
					"annotations": {
						"readOnlyHint": true
					}
				}
			]
		}
	}

	normalized := normalize_mcp_2026_list_tools_result(response)
	assert_equal(normalized["ok"], true)
	assert_equal(normalized["ttl_ms"], 300000)
	assert_equal(normalized["cache_scope"], "public")
	assert_equal(normalized["next_cursor"], "next-page")
	assert_equal(normalized["metadata"]["cacheable"], true)

	mapped := map_mcp_2026_tool_to_registry_entry(normalized["tools"][0], {})
	assert_equal(mapped["id"], "mcp.search")
	assert_equal(mapped["name"], "search")
	assert_equal(mapped["input_schema"]["properties"]["query"]["x-mcp-header"], "Query")
	assert_equal(mapped["metadata"]["protocol_version"], "2026-07-28")
	assert_equal(mapped["metadata"]["input_schema_dialect"], "https://json-schema.org/draft/2020-12/schema")
	assert_equal(mapped["metadata"]["title"], "Search")
	assert_equal(mapped["metadata"]["icons"][0]["mimeType"], "image/png")
	assert_equal(mapped["metadata"]["annotations"]["readOnlyHint"], true)
}

test "mcp 2026 call results normalize complete input-required and version errors" {
	complete := normalize_mcp_2026_call_tool_result({
		"result": {
			"resultType": "complete",
			"content": [
				{
					"type": "text",
					"text": "done"
				}
			],
			"structuredContent": {
				"count": 1
			},
			"isError": false
		}
	})
	assert_equal(complete["ok"], true)
	assert_equal(complete["status"], "complete")
	assert_equal(complete["content"][0]["text"], "done")
	assert_equal(complete["structured_content"]["count"], 1)

	input_required := normalize_mcp_2026_call_tool_result({
		"result": {
			"resultType": "input_required",
			"inputRequests": {
				"confirm": {
					"method": "elicitation/create"
				}
			},
			"requestState": "opaque-state"
		}
	})
	assert_equal(input_required["ok"], true)
	assert_equal(input_required["status"], "input_required")
	assert_equal(input_required["input_requests"]["confirm"]["method"], "elicitation/create")
	assert_equal(input_required["request_state"], "opaque-state")

	error_response := create_mcp_2026_unsupported_protocol_error("1900-01-01", ["2026-07-28", "2025-11-25"])
	assert_equal(error_response["error"]["code"], -32022)
	assert_equal(error_response["error"]["data"]["supported"][0], "2026-07-28")
	assert_equal(error_response["error"]["data"]["requested"], "1900-01-01")
}

test "external tool provider adapter lists and invokes tools" {
	provider := create_external_tool_provider_adapter({
		"provider_name": "mcp",
		"list_tools_fn": func(provider_map, options) {
			return [
				{
					"id": "mcp.search",
					"name": "search",
					"description": "Search external index"
				}
			]
		},
		"invoke_tool_fn": func(provider_map, tool_name, payload, context) {
			return {
				"ok": true,
				"tool_name": tool_name,
				"result": {
					"echo": payload
				}
			}
		}
	})

	listed := external_provider_list_tools(provider, {})
	assert_equal(listed["ok"], true)
	assert_equal(len(listed["tools"]), 1)
	assert_equal(listed["tools"][0]["name"], "search")

	invoked := external_provider_invoke_tool(provider, "search", {
		"query": "agents"
	}, {})
	assert_equal(invoked["ok"], true)
	assert_equal(invoked["tool_name"], "search")
	assert_equal(invoked["result"]["echo"]["query"], "agents")

	mapped := map_external_tool_to_registry_entry(listed["tools"][0], {
		"provider_name": "mcp"
	})
	assert_equal(mapped["id"], "mcp.search")
	assert_equal(mapped["metadata"]["integration_provider"], "mcp")
}

test "dispatch integration hooks execute adapter callbacks" {
	hooks := create_dispatch_integration_hooks({
		"run_agent_step_fn": func(step_payload, options) {
			return {
				"ok": true,
				"step": step_payload["step_id"]
			}
		},
		"invoke_workflow_fn": func(workflow_name, workflow_input, options) {
			return {
				"ok": true,
				"workflow": workflow_name,
				"input": workflow_input
			}
		}
	})

	step_result := dispatch_run_agent_step(hooks, {
		"step_id": "step-1"
	}, {})
	assert_equal(step_result["ok"], true)
	assert_equal(step_result["step"], "step-1")

	workflow_result := dispatch_invoke_workflow_as_tool(hooks, "compile_report", {
		"run_id": "run-1"
	}, {})
	assert_equal(workflow_result["ok"], true)
	assert_equal(workflow_result["workflow"], "compile_report")
}

test "watchdog trace adapter maps default and custom transformations" {
	default_adapter := create_watchdog_trace_adapter({})
	default_result := watchdog_transform_trace_event(default_adapter, {
		"trace_id": "trc-1",
		"run_id": "run-1",
		"agent_id": "agent-1",
		"event_kind": "run_started",
		"timestamp": "2026-05-27 00:00:00",
		"sequence": 1,
		"payload": {
			"input": "hello"
		}
	}, {})
	assert_equal(default_result["ok"], true)
	assert_equal(default_result["record"]["metadata"]["adapter"], "watchdog")

	custom_adapter := create_watchdog_trace_adapter({
		"transform_trace_fn": func(trace_event, options) {
			return {
				"ok": true,
				"record": {
					"kind": trace_event["event_kind"],
					"run": trace_event["run_id"]
				}
			}
		}
	})
	custom_result := watchdog_transform_trace_event(custom_adapter, {
		"event_kind": "run_completed",
		"run_id": "run-2"
	}, {})
	assert_equal(custom_result["ok"], true)
	assert_equal(custom_result["record"]["kind"], "run_completed")
}

test "scout code-context provider resolves context and maps retrieval enrichment" {
	provider := create_scout_code_context_provider({
		"provider_name": "scout",
		"resolve_context_fn": func(provider_map, request_payload, options) {
			return {
				"ok": true,
				"summary": "Relevant code context for runner lifecycle",
				"entries": [
					{
						"entry_id": "entry-1",
						"file_path": "src/agents/runner.kujo",
						"symbol_name": "run_agent_impl",
						"snippet": "func run_agent_impl(agent_input, run_request_input, options) {",
						"score": 0.93,
						"start_line": 600,
						"end_line": 750,
						"metadata": {
							"source": "fixture"
						}
					}
				]
			}
		}
	})

	resolved := scout_provider_resolve_context(provider, {
		"query_text": "runner lifecycle and handoff flow",
		"path_hints": [
			"src/agents/runner.kujo"
		],
		"top_k": 3
	}, {})

	assert_equal(resolved["ok"], true)
	assert_equal(resolved["count"], 1)
	assert_equal(resolved["context"]["provider_name"], "scout")
	assert_equal(resolved["context"]["entries"][0]["file_path"], "src/agents/runner.kujo")
	assert_equal(resolved["metadata"]["integration_provider"], "scout")

	enrichment := map_scout_context_to_retrieval_enrichment(resolved, {})
	assert_equal(enrichment["ok"], true)
	assert_equal(len(enrichment["retrieval_enrichment"]["documents"]), 1)
	assert_equal(enrichment["retrieval_enrichment"]["documents"][0]["document_id"], "scout-doc-1")
	assert_equal(enrichment["retrieval_enrichment"]["documents"][0]["source"], "src/agents/runner.kujo")
	assert_equal(enrichment["retrieval_enrichment"]["citations"][0]["citation_id"], "scout-citation-1")
	assert_equal(enrichment["retrieval_enrichment"]["metadata"]["integration_provider"], "scout")
}

test "scout code-context provider returns deterministic errors for missing callbacks and invalid queries" {
	unconfigured := create_scout_code_context_provider({
		"provider_name": "scout"
	})
	not_implemented := scout_provider_resolve_context(unconfigured, {
		"query_text": "runner"
	}, {})
	assert_equal(not_implemented["ok"], false)
	assert_equal(not_implemented["error"]["kind"], "not_implemented")

	provider := create_scout_code_context_provider({
		"provider_name": "scout",
		"resolve_context_fn": func(provider_map, request_payload, options) {
			return {
				"ok": true,
				"entries": []
			}
		}
	})
	invalid_query := scout_provider_resolve_context(provider, {
		"query_text": ""
	}, {})
	assert_equal(invalid_query["ok"], false)
	assert_equal(invalid_query["error"]["kind"], "invalid_request")
}
