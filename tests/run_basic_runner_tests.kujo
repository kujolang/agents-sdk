	assert_equal(result["metadata"]["budget"]["checks"][1]["ok"], false)
}

test "runner enforces timeout before model using injected runtime clock" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "should not run",
			"status_code": 200
		}
	}

	clock := {
		"tick": 0
	}
	runtime_services := create_runtime_services({
		"now_ms_fn": func() {
			tick := clock["tick"]
			if tick == 0 {
				clock["tick"] := 1
				return 0
			}
			return 500
		}
	})

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "timeout-before",
		"name": "Timeout Before"
	})
	run_request := create_agent_run_request("timeout cutoff", {
		"run_id": "run-timeout-before",
		"runtime_services": runtime_services
	})

	result := run_agent(runner, agent, run_request, {
		"timeout_ms": 100
	})

	assert_equal(result["status"], "timeout")
	assert_equal(result["error"]["kind"], "timeout")
	assert_equal(len(result["steps"]), 0)
	assert_equal(result["metadata"]["events"][0]["kind"], "run_started")
	assert_equal(result["metadata"]["events"][len(result["metadata"]["events"]) - 1]["kind"], "run_failed")
	assert_equal(result["metadata"]["timeout"]["last_check"]["stage"], "before_model")
	assert_equal(result["metadata"]["timeout"]["last_check"]["exceeded"], true)
}

test "runner enforces timeout after model independent of provider result" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "timeout after model",
			"status_code": 200
		}
	}

	clock := {
		"tick": 0
	}
	runtime_services := create_runtime_services({
		"now_ms_fn": func() {
			tick := clock["tick"]
			if tick == 0 {
				clock["tick"] := 1
				return 0
			}
			if tick == 1 {
				clock["tick"] := 2
				return 40
			}
			return 300
		}
	})

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "timeout-after",
		"name": "Timeout After"
	})
	run_request := create_agent_run_request("timeout after model", {
		"run_id": "run-timeout-after",
		"runtime_services": runtime_services
	})

	result := run_agent(runner, agent, run_request, {
		"timeout_ms": 100
	})

	assert_equal(result["status"], "timeout")
	assert_equal(result["error"]["kind"], "timeout")
	assert_equal(len(result["steps"]), 1)
	assert_equal(result["steps"][0]["step_kind"], "model")
	assert_equal(result["metadata"]["events"][0]["kind"], "run_started")
	assert_equal(result["metadata"]["events"][len(result["metadata"]["events"]) - 1]["kind"], "run_failed")
	assert_equal(result["metadata"]["timeout"]["last_check"]["stage"], "after_model")
	assert_equal(result["metadata"]["timeout"]["last_check"]["exceeded"], true)
}

