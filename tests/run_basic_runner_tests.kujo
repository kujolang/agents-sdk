test_setup {
	from src.agents.core_types import create_agent, create_agent_run_request
	from src.agents.ai.adapter import create_ai_sdk_adapter
	from src.agents.runner import create_agent_runner, run_agent
	from src.agents.tools.registry import create_tool_registry, register_tool
	from src.agents.retrieval.provider import create_mock_retrieval_provider
	from src.agents.artifacts.store import create_in_memory_artifact_store, reset_in_memory_artifact_store, artifact_store_list
	from src.agents.runtime.clock_ids import create_runtime_services
	from src.agents.streaming.events import map_ai_sdk_stream_event
}

test "runner completes basic non-stream agent run with mock model adapter" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "Summary complete",
			"status_code": 200,
			"usage": {
				"input_tokens": 8,
				"output_tokens": 4,
				"total_tokens": 12
			}
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "writer",
		"name": "Writer",
		"instructions": "Be concise.",
		"model_policy": {
			"model": "gpt-4.1-mini",
			"max_tokens": 64
		}
	})
	run_request := create_agent_run_request("Summarize this", {
		"run_id": "run-1",
		"session_id": "session-1"
	})

	result := run_agent(runner, agent, run_request, {})

	assert_equal(result["status"], "completed")
	assert_equal(result["output"]["text"], "Summary complete")
	assert_equal(len(result["steps"]), 2)
	assert_equal(result["steps"][0]["step_kind"], "model")
	assert_equal(result["steps"][1]["step_kind"], "final")
	assert_equal(result["metadata"]["events"][0]["kind"], "run_started")
	assert_equal(result["metadata"]["events"][len(result["metadata"]["events"]) - 1]["kind"], "run_completed")
}

test "runner returns invalid_config when ai adapter is missing" {
	runner := create_agent_runner({})
	agent := create_agent({
		"id": "writer",
		"name": "Writer"
	})
	run_request := create_agent_run_request("hello", {
		"run_id": "run-2"
	})

	result := run_agent(runner, agent, run_request, {})
	assert_equal(result["status"], "failed")
	assert_equal(result["error"]["kind"], "invalid_config")
}

test "runner returns failed status when model adapter returns error" {
	fake_chat_error := func(client, messages, request_options) {
		return {
			"ok": false,
			"provider": "openai",
			"status_code": 504,
			"error": {
				"code": "timeout",
				"message": "Model timeout",
				"retryable": true
			}
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat_error
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "planner",
		"name": "Planner"
	})
	run_request := create_agent_run_request("plan this", {
		"run_id": "run-3"
	})

	result := run_agent(runner, agent, run_request, {})
	assert_equal(result["status"], "failed")
	assert_equal(result["error"]["kind"], "timeout")
	assert_equal(result["metadata"]["events"][len(result["metadata"]["events"]) - 1]["kind"], "run_failed")
}

test "runner exits with cancelled status before model call when token is cancelled" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "This should not be used",
			"status_code": 200
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "cancel-before",
		"name": "Cancel Before"
	})
	run_request := create_agent_run_request("stop now", {
		"run_id": "run-cancel-before"
	})

	result := run_agent(runner, agent, run_request, {
		"cancellation_token": {
			"cancel_at_stage": "before_model"
		}
	})

	assert_equal(result["status"], "cancelled")
	assert_equal(result["error"]["kind"], "cancelled")
	assert_equal(result["error"]["details"]["cancelled_stage"], "before_model")
	assert_equal(len(result["steps"]), 0)
	assert_equal(result["metadata"]["events"][0]["kind"], "run_started")
	assert_equal(result["metadata"]["events"][len(result["metadata"]["events"]) - 1]["kind"], "run_cancelled")
}

test "runner exits with cancelled status after model call when token stage matches" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "Interim response",
			"status_code": 200,
			"usage": {
				"input_tokens": 10,
				"output_tokens": 2,
				"total_tokens": 12
			}
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "cancel-after",
		"name": "Cancel After"
	})
	run_request := create_agent_run_request("continue", {
		"run_id": "run-cancel-after"
	})

	result := run_agent(runner, agent, run_request, {
		"cancellation_token": {
			"cancel_at_stage": "after_model"
		}
	})

	assert_equal(result["status"], "cancelled")
	assert_equal(result["error"]["kind"], "cancelled")
	assert_equal(result["error"]["details"]["cancelled_stage"], "after_model")
	assert_equal(len(result["steps"]), 1)
	assert_equal(result["steps"][0]["step_kind"], "model")
	assert_equal(result["metadata"]["events"][0]["kind"], "run_started")
	assert_equal(result["metadata"]["events"][len(result["metadata"]["events"]) - 1]["kind"], "run_cancelled")
}

test "runner stops before model when budget is already exceeded" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "should not run",
			"status_code": 200
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "budget-before",
		"name": "Budget Before"
	})
	run_request := create_agent_run_request("budget stop", {
		"run_id": "run-budget-before"
	})

	result := run_agent(runner, agent, run_request, {
		"budget_policy": {
			"mode": "enforce",
			"budget": {
				"limits": {
					"max_steps": 1
				}
			}
		},
		"budget_usage": {
			"steps": 3
		}
	})

	assert_equal(result["status"], "budget_exceeded")
	assert_equal(result["error"]["kind"], "budget_exceeded")
	assert_equal(len(result["steps"]), 0)
	assert_equal(result["metadata"]["events"][0]["kind"], "run_started")
	assert_equal(result["metadata"]["events"][len(result["metadata"]["events"]) - 1]["kind"], "run_failed")
	assert_equal(result["metadata"]["budget"]["checks"][0]["stage"], "before_model")
	assert_equal(result["metadata"]["budget"]["checks"][0]["ok"], false)
}

