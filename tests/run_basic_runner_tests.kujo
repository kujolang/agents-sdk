}

test "runner retries retryable model failures and succeeds within retry budget" {
	fake_chat_retry_success := func(client, messages, request_options) {
		retry_attempt := request_options["retry_attempt"]
		if retry_attempt < 2 {
			return {
				"ok": false,
				"provider": "openai",
				"status_code": 504,
				"error": {
					"kind": "timeout",
					"code": "timeout",
					"message": "retry me",
					"retryable": true
				}
			}
		}

		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "Recovered after retry",
			"status_code": 200
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat_retry_success
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "retry-success",
		"name": "Retry Success"
	})
	run_request := create_agent_run_request("try again", {
		"run_id": "run-retry-success"
	})

	result := run_agent(runner, agent, run_request, {
		"retry_policy": {
			"max_model_retries": 2,
			"max_tool_retries": 0
		}
	})

	assert_equal(result["status"], "completed")
	assert_equal(result["output"]["text"], "Recovered after retry")
	assert_equal(result["metadata"]["retry_counters"]["model_attempts"], 2)
	assert_equal(result["metadata"]["retry_counters"]["model_retries_used"], 1)
	assert_equal(result["metadata"]["retry_counters"]["max_model_retries"], 2)
}

test "runner fails deterministically when retry budget is exhausted" {
	fake_chat_retry_exhausted := func(client, messages, request_options) {
		return {
			"ok": false,
			"provider": "openai",
			"status_code": 504,
			"error": {
				"kind": "timeout",
				"code": "timeout",
				"message": "still failing",
				"retryable": true
			}
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat_retry_exhausted
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "retry-failed",
		"name": "Retry Failed"
	})
	run_request := create_agent_run_request("still fail", {
		"run_id": "run-retry-failed"
	})

	result := run_agent(runner, agent, run_request, {
		"retry_policy": {
			"max_model_retries": 1,
			"max_tool_retries": 0
		}
	})

	assert_equal(result["status"], "failed")
	assert_equal(result["error"]["kind"], "timeout")
	assert_equal(result["metadata"]["retry_counters"]["model_attempts"], 2)
	assert_equal(result["metadata"]["retry_counters"]["model_retries_used"], 1)
	assert_equal(result["metadata"]["events"][len(result["metadata"]["events"]) - 1]["kind"], "run_failed")
}

test "runner rejects unknown requested tools before model execution" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "should not execute",
			"status_code": 200
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "tool-check",
		"name": "Tool Check"
	})

	registry := create_tool_registry({})
	register_result := register_tool(registry, {
		"id": "tool-existing",
		"name": "existing_tool"
	})
	assert_equal(register_result["ok"], true)

	run_request := create_agent_run_request("use tools", {
		"run_id": "run-unknown-tool",
		"metadata": {
			"requested_tools": ["missing_tool"]
		}
	})

	result := run_agent(runner, agent, run_request, {
		"tool_registry": register_result["registry"]
	})

	assert_equal(result["status"], "failed")
	assert_equal(result["error"]["kind"], "tool_not_found")
	assert_equal(len(result["steps"]), 0)
	assert_equal(result["metadata"]["events"][0]["kind"], "run_started")
	assert_equal(result["metadata"]["events"][len(result["metadata"]["events"]) - 1]["kind"], "run_failed")
	assert_equal(result["metadata"]["requested_tool_names"][0], "missing_tool")
}

test "runner executes model-emitted tool calls using registry handlers" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "tool call completed",
			"status_code": 200,
			"tool_calls": [
				{
					"name": "echo_tool",
					"input": {
						"content": "hello from tool"
					}
				}
			]
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "tool-runner",
		"name": "Tool Runner"
	})

	registry := create_tool_registry({})
	register_result := register_tool(registry, {
		"id": "tool-echo",
		"name": "echo_tool",
		"handler": func(input_payload, context) {
			return {
				"ok": true,
				"output": {
					"executed": true,
					"content": input_payload["content"]
				}
			}
		}
	})
	assert_equal(register_result["ok"], true)

	run_request := create_agent_run_request("invoke tool", {
		"run_id": "run-tool-call",
		"session_id": "session-tool-call"
	})

	result := run_agent(runner, agent, run_request, {
		"tool_registry": register_result["registry"]
	})

	assert_equal(result["status"], "completed")
	assert_equal(result["output"]["text"], "tool call completed")
	assert_equal(result["steps"][1]["step_kind"], "tool_call")
	assert_equal(len(result["metadata"]["tool_calls"]), 1)
	assert_equal(result["metadata"]["tool_calls"][0]["result"]["ok"], true)
	assert_equal(result["metadata"]["tool_calls"][0]["result"]["output"]["executed"], true)
}

test "runner fails with approval_denied when tool call is denied by approval provider" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "tool call blocked",
			"status_code": 200,
			"tool_calls": [
				{
					"name": "write_tool",
					"input": {
						"content": "blocked write"
					}
				}
			]
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "approval-tool-runner",
		"name": "Approval Tool Runner"
	})

	registry := create_tool_registry({})
	register_result := register_tool(registry, {
		"id": "tool-write",
		"name": "write_tool",
		"permissions": ["write"],
		"handler": func(input_payload, context) {
			return {
				"ok": true,
				"output": {
					"executed": true
				}
			}
		}
	})
	assert_equal(register_result["ok"], true)

	run_request := create_agent_run_request("invoke blocked tool", {
		"run_id": "run-approval-denied",
		"session_id": "session-approval-denied"
	})

	result := run_agent(runner, agent, run_request, {
		"tool_registry": register_result["registry"],
		"approval_policy": {
			"mode": "write_tool"
		},
		"approval_provider": {
			"kind": "deny_all"
		}
	})

	assert_equal(result["status"], "failed")
	assert_equal(result["error"]["kind"], "approval_denied")
	assert_equal(len(result["metadata"]["tool_calls"]), 1)
	assert_equal(result["metadata"]["tool_calls"][0]["result"]["status"], "approval_denied")
	assert_equal(result["metadata"]["events"][len(result["metadata"]["events"]) - 1]["kind"], "run_failed")
}

test "runner stream run fails deterministically on guardrail_blocked event" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "fallback",
			"status_code": 200
		}
	}

	fake_stream := func(client, messages, request_options, on_event) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "should-block",
			"status_code": 200,
			"emitted_events": [
				{
					"type": "guardrail_blocked",
					"payload": {
						"rule": "policy.guardrail"
					}
				}
			]
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat,
		"chat_completion_stream_fn": fake_stream
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "guardrail-runner",
		"name": "Guardrail Runner"
	})
	run_request := create_agent_run_request("trigger guardrail", {
		"run_id": "run-guardrail-blocked",
		"session_id": "session-guardrail-blocked"
	})

	result := run_agent(runner, agent, run_request, {
		"stream": true
	})

	assert_equal(result["status"], "failed")
	assert_equal(result["error"]["kind"], "guardrail_blocked")
	assert_equal(result["metadata"]["stream"]["events_count"] >= 1, true)
}

test "runner injects retrieval context into model messages when enabled" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "retrieval-context-applied",
			"status_code": 200
		}
	}

	retrieval_provider := create_mock_retrieval_provider({
		"responses": {
			"what should happen": {
				"context": {
					"context_id": "ctx-rag-002",
					"summary": "Relevant prior notes",
					"documents": [
						{
							"document_id": "doc-rag-1",
							"title": "RAG note",
							"content": "Use retrieved context before model generation.",
							"metadata": {
								"path": "knowledge/rag-note.md"
							}
						}
					],
					"citations": [
						{
							"citation_id": "cite-rag-1",
							"document_id": "doc-rag-1",
							"score": 0.91,
							"metadata": {
								"path": "knowledge/rag-note.md"
							}
						}
					]
				}
			}
		}
	})

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "rag-agent",
		"name": "RAG Agent",
		"instructions": "Use retrieval when available.",
		"policy": {
			"retrieval": {
				"enabled": true,
				"max_documents": 1
			}
		}
	})
	run_request := create_agent_run_request("what should happen", {
		"run_id": "run-rag-002",
		"session_id": "session-rag-002"
	})

	result := run_agent(runner, agent, run_request, {
		"retrieval_provider": retrieval_provider
	})

	assert_equal(result["status"], "completed")
	assert_equal(result["output"]["text"], "retrieval-context-applied")
	assert_equal(result["steps"][0]["payload"]["messages_count"], 3)
	assert_equal(result["metadata"]["retrieval"]["applied"], true)
	assert_equal(result["metadata"]["retrieval"]["reason"], "applied")
	assert_equal(result["metadata"]["retrieval"]["result"]["count"] >= 1, true)
	assert_equal(result["metadata"]["retrieval"]["citation_count"], 1)
	assert_equal(result["metadata"]["retrieval"]["citations"][0]["citation_id"], "citation-doc-1")
	assert_equal(result["metadata"]["retrieval"]["citations"][0]["document_id"], "doc-rag-1")
	assert_equal(result["metadata"]["retrieval"]["citations"][0]["path"], "knowledge/rag-note.md")
	run_completed_event := result["metadata"]["events"][len(result["metadata"]["events"]) - 1]
	assert_equal(run_completed_event["payload"]["citation_count"], 1)
	assert_equal(run_completed_event["payload"]["citations"][0]["citation_id"], "citation-doc-1")
	assert_equal(contains(result["metadata"]["retrieval"]["context_message"], "Retrieved context:") >= 0, true)
}

test "runner executes explicit handoff to configured target agent" {
	fake_chat := func(client, messages, request_options) {
		first_content := ""
		if len(messages) > 0 {
			first_message := messages[0]
			if type(first_message) == "dict" {
				first_content = to_string(first_message["content"])
			}
		}

		is_writer_run := first_content == "Writer target instructions."
		if is_writer_run {
			return {
				"ok": true,
				"provider": "openai",
				"model": "gpt-4.1-mini",
				"output_text": "writer-final-output",
				"status_code": 200
			}
		}

		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "planner-draft-output",
			"status_code": 200
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	planner_agent := create_agent({
		"id": "planner-agent",
		"name": "Planner Agent",
		"instructions": "Planner source instructions.",
		"policy": {
			"target_agent_id": "writer-agent",
			"target_agent_reason": "Writer should finalize tone.",
			"request_id": "handoff-test-request",
			"handoff": {
				"target_agent_id": "writer-agent",
				"reason": "Writer should finalize tone.",
				"request_id": "handoff-test-request"
			}
		},
		"model_policy": {
			"handoff_marker": "planner"
		}
	})
	writer_agent := create_agent({
		"id": "writer-agent",
		"name": "Writer Agent",
		"instructions": "Writer target instructions.",
		"model_policy": {
			"handoff_marker": "writer"
		}
	})
	runner = create_agent_runner({
		"ai_adapter": adapter,
		"handoff_registry": {
			"writer-agent": writer_agent
		}
	})
	assert_equal(len(keys(runner["handoff_registry"])), 1)
	assert_equal(planner_agent["instructions"], "Planner source instructions.")
	assert_equal(planner_agent["model_policy"]["handoff_marker"], "planner")
	assert_equal(writer_agent["model_policy"]["handoff_marker"], "writer")

	run_request := create_agent_run_request("plan then write", {
		"run_id": "run-handoff-1",
		"session_id": "session-handoff-1",
		"metadata": {
			"requested_tools": ["writer-agent"]
		}
	})
	assert_equal(type(run_request), "dict")

	tool_registry := create_tool_registry({})
	register_result := register_tool(tool_registry, {
		"id": "tool-handoff-target",
		"name": "writer-agent"
	})
	assert_equal(register_result["ok"], true)

	result := run_agent(runner, planner_agent, run_request, {
		"tool_registry": register_result["registry"]
	})

	assert_equal(result["status"], "completed")
	assert_equal(result["output"]["text"], "writer-final-output")
	assert_equal(len(result["steps"]) >= 2, true)
	assert_equal(result["metadata"]["handoff"]["requested"], true)
	assert_equal(result["metadata"]["handoff"]["executed"], true)
	assert_equal(result["metadata"]["handoff"]["loop_state"]["depth"], 1)
	handoff_started_count := 0
	handoff_completed_count := 0
	handoff_failed_count := 0
	for event in result["metadata"]["events"] {
		if type(event) == "dict" {
			if has_key(event, "kind") {
				kind := to_string(event["kind"])
				if contains(kind, "handoff_started") >= 0 {
					handoff_started_count = handoff_started_count + 1
				}
				if contains(kind, "handoff_completed") >= 0 {
					handoff_completed_count = handoff_completed_count + 1
				}
				if contains(kind, "handoff_failed") >= 0 {
					handoff_failed_count = handoff_failed_count + 1
				}
			}
		}
	}
	assert_equal(handoff_started_count >= 1, true)
	assert_equal(handoff_completed_count >= 1, true)
	assert_equal(result["metadata"]["handoff"]["target_status"], "completed")
}

test "runner persists final output artifact and returns artifact references" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "Artifact-ready summary",
			"status_code": 200
		}
	}

	store_id := "run-artifact-001"
	reset_result := reset_in_memory_artifact_store({
		"store_id": store_id
	})
	assert_equal(reset_result["ok"], true)

	artifact_store := create_in_memory_artifact_store({
		"store_id": store_id
	})

	retrieval_provider := create_mock_retrieval_provider({
		"responses": {
			"Generate an artifact": {
				"context": {
					"context_id": "ctx-rag-003",
					"summary": "Artifact response should preserve citations.",
					"documents": [
						{
							"document_id": "doc-artifact-1",
							"title": "Artifact source",
							"content": "Citations should be attached to output artifacts.",
							"metadata": {
								"path": "knowledge/artifacts.md"
							}
						}
					],
					"citations": [
						{
							"citation_id": "cite-artifact-1",
							"document_id": "doc-artifact-1",
							"score": 0.88,
							"metadata": {
								"path": "knowledge/artifacts.md"
							}
						}
					]
				}
			}
		}
	})

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "artifact-writer",
		"name": "Artifact Writer",
		"instructions": "Write final output.",
		"policy": {
			"retrieval": {
				"enabled": true,
				"max_documents": 1
			}
		}
	})
	run_request := create_agent_run_request("Generate an artifact", {
		"run_id": "run-artifact-1",
		"session_id": "session-artifact-1"
	})

	result := run_agent(runner, agent, run_request, {
		"artifact_store": artifact_store,
		"retrieval_provider": retrieval_provider
	})

	assert_equal(result["status"], "completed")
	assert_equal(len(result["artifacts"]), 1)
	assert_equal(result["artifacts"][0]["artifact_kind"], "markdown")
	assert_equal(result["artifacts"][0]["producer_run_id"], "run-artifact-1")
	assert_equal(result["artifacts"][0]["producer_tool_name"], "runner.final_output")
	run_completed_event := result["metadata"]["events"][len(result["metadata"]["events"]) - 1]
	assert_equal(run_completed_event["payload"]["artifact_count"], 1)
	assert_equal(run_completed_event["payload"]["citation_count"], 1)
	assert_equal(result["artifacts"][0]["metadata"]["retrieval_citation_count"], 1)
	assert_equal(contains(result["artifacts"][0]["metadata"]["retrieval_citation_refs"], "citation-doc-1|doc-artifact-1|knowledge/artifacts.md") >= 0, true)
	assert_equal(result["metadata"]["artifact_store_writes"][0]["stage"], "final_output")
	assert_equal(result["steps"][2]["step_kind"], "artifact")

	stored := artifact_store_list(artifact_store, {})
	assert_equal(stored["ok"], true)
	assert_equal(stored["count"], 1)
	assert_equal(stored["artifacts"][0]["content"], "Artifact-ready summary")
}

test "runner blocks handoff loop using visited target history" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "planner-output",
			"status_code": 200
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat
	})
	writer_agent := create_agent({
		"id": "writer-agent",
		"name": "Writer Agent",
		"instructions": "Writer target instructions."
	})
	runner := create_agent_runner({
		"ai_adapter": adapter,
		"handoff_registry": {
			"writer-agent": writer_agent
		}
	})
	planner_agent := create_agent({
		"id": "planner-agent",
		"name": "Planner Agent",
		"instructions": "Planner source instructions.",
		"policy": {
			"target_agent_id": "writer-agent"
		}
	})

	run_request := create_agent_run_request("plan then write", {
		"run_id": "run-handoff-loop",
		"session_id": "session-handoff-loop",
		"metadata": {
			"requested_tools": ["writer-agent"],
			"handoff_depth": 1,
			"handoff_max_depth": 3,
			"handoff_visited_targets": ["planner-agent", "writer-agent"]
		}
	})
	tool_registry := create_tool_registry({})
	register_result := register_tool(tool_registry, {
		"id": "tool-handoff-loop-target",
		"name": "writer-agent"
	})
	assert_equal(register_result["ok"], true)

	result := run_agent(runner, planner_agent, run_request, {
		"tool_registry": register_result["registry"]
	})

	assert_equal(result["status"], "failed")
	assert_equal(result["error"]["kind"], "handoff_failed")
	assert_equal(result["error"]["details"]["violation"], "loop_detected")

	handoff_failed_count := 0
	for event in result["metadata"]["events"] {
		if event["kind"] == "handoff_failed" {
			handoff_failed_count = handoff_failed_count + 1
		}
	}
	assert_equal(handoff_failed_count >= 1, true)
}

