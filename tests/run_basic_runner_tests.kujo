}

test "runner stream and non-stream modes produce equivalent terminal output" {
	fake_chat := func(client, messages, request_options) {
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "stream-final-output",
			"status_code": 200
		}
	}

	fake_stream := func(client, messages, request_options, on_event) {
		on_event({"type": "delta", "delta": "stream-"})
		on_event({"type": "tool_call_started", "tool_name": "search"})
		on_event({"type": "tool_call_completed", "tool_name": "search"})
		on_event({"type": "done", "finish_reason": "stop"})
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "stream-final-output",
			"status_code": 200,
			"emitted_events": [
				{"type": "delta", "delta": "stream-"},
				{"type": "tool_call_started", "tool_name": "search"},
				{"type": "tool_call_completed", "tool_name": "search"},
				{"type": "done", "finish_reason": "stop"}
			]
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": fake_chat,
		"chat_completion_stream_fn": fake_stream
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "stream-agent",
		"name": "Stream Agent"
	})
	run_request := create_agent_run_request("stream request", {
		"run_id": "run-stream-parity",
		"session_id": "session-stream-parity"
	})
	stream_run_request := create_agent_run_request("stream request", {
		"run_id": "run-stream-parity",
		"session_id": "session-stream-parity",
		"stream": true
	})

	non_stream_result := run_agent(runner, agent, run_request, {
		"stream": false
	})
	stream_result := run_agent(runner, agent, stream_run_request, {})

	assert_equal(non_stream_result["status"], "completed")
	assert_equal(stream_result["status"], "completed")
	assert_equal(stream_result["output"]["text"], non_stream_result["output"]["text"])
	assert_equal(stream_result["metadata"]["stream"]["enabled"], true)
	assert_equal(stream_result["metadata"]["stream"]["events_count"], 4)
	assert_equal(stream_result["metadata"]["stream"]["events"][0]["kind"], "model_delta")
	assert_equal(stream_result["metadata"]["stream"]["events"][1]["kind"], "tool_call_started")
	assert_equal(stream_result["metadata"]["stream"]["events"][2]["kind"], "tool_call_completed")
	assert_equal(stream_result["metadata"]["stream"]["events"][3]["kind"], "run_terminal")
}

test "runner fails when stream callback raises an exception" {
	fake_stream := func(client, messages, request_options, on_event) {
		on_event({"type": "delta", "delta": "partial"})
		return {
			"ok": true,
			"provider": "openai",
			"model": "gpt-4.1-mini",
			"output_text": "ignored",
			"status_code": 200,
			"emitted_events": [
				{"type": "delta", "delta": "partial"}
			]
		}
	}

	adapter := create_ai_sdk_adapter({
		"chat_completion_fn": func(client, messages, request_options) {
			return {
				"ok": true,
				"provider": "openai",
				"model": "gpt-4.1-mini",
				"output_text": "ignored",
				"status_code": 200
			}
		},
		"chat_completion_stream_fn": fake_stream
	})
	runner := create_agent_runner({
		"ai_adapter": adapter
	})
	agent := create_agent({
		"id": "stream-callback-fail",
		"name": "Stream Callback Fail"
	})
	run_request := create_agent_run_request("stream callback fail", {
		"run_id": "run-stream-callback-fail",
		"stream": true
	})

	result := run_agent(runner, agent, run_request, {
		"on_stream_event": func(event) {
			parse_json("{")
		}
	})

	assert_equal(result["status"], "failed")
	assert_equal(result["error"]["kind"], "model_error")
	assert_equal(result["metadata"]["context"]["stream"]["events_count"] >= 1, true)
}

test "guardrail stream events map to deterministic guardrail_blocked kind" {
	mapped := map_ai_sdk_stream_event({
		"type": "guardrail_blocked",
		"rule": "policy.guardrail"
	}, {
		"run_id": "run-stream-guardrail",
		"agent_id": "stream-guardrail",
		"session_id": "session-stream-guardrail",
		"sequence": 1
	})

